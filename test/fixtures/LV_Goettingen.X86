mily:Arial;font-size:10pt;">Für Stromkreise mit steckbaren Endverbrauchern auf Schukosteckdose</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Daten, Mindestleistungen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gruppen-Vorsicherung D02 (siehe Vorposition)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Personen- und Leitungsschutz mit RCBO - FI/LS-Schutzschalter, 1P+N, 10 kA, C-16 A, 30 mA je Stromkreis</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abgangsklemmen je Stromkreis</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leitungs- und Klemmenquerschnittsgrößen sind den Stromkreisen angepasst.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Leistungsmerkmale der eingesetzten Geräte sind der Ausführungsbeschreibung zu den schrankinternen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">elektrischen Betriebsmitteln/ Geräten zu entnehmen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stromkreis 230 V/16 A, nicht schaltbar</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id186" RNoPart="2"><Qty>1.000</Qty><QU>St</QU><UP>20.700</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relais, Wechseler, 2-fach, 24VDC, 230VAC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hutschinenmodul</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Gehäuse</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Realis, Wechseler, 2-fach, 24VDC, 230VAC</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id187" RNoPart="3"><Qty>1.000</Qty><QU>St</QU><UP>3325.800</UP><Description><CompleteText><DetailTxt><Text><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1HE</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">650VA</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">230V</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lithium-Ionen-USV</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lan-Anschluss und Software zur Remote Steuerung für Überwachung und kontrolliertem Herunterfahren einzelner Rechner.</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;"><span style="font-size:10pt;font-family:Arial;">USV</span><span style="font-size:10pt;font-family:Arial;"> On-Line 19 Zoll 640VA</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>3640.50</Total><TotalGross>4332.20</TotalGross></Totals></BoQCtgy><BoQCtgy ID="id188" RNoPart="13"><LblTx><p><span>Allgemeinleistungen</span></p></LblTx><BoQBody><Itemlist><Remark ID="id189"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Ausführung der Stundenlohnarbeiten erfolgt grundsätzlich nur in Ausnahmefällen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stundenlohnarbeiten sind vor Ausführung über die Objektüberwachung / Fachbauleitung bei der Projektleitung (LBIH) zu beantragen. Mit der Ausführung der Stundenlohnarbeiten ist erst nach schriftlicher Anordnung der Projektleitung zu beginnen. Der Umfang, der im Einzelfall zu erbringenden Leistung, wird bei der Anordnung festgelegt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Beantragung der Stundenlohnarbeiten sowie der Nachweis der Stundenlohnarbeiten sind mit dem &#x22;Laufzettel Stundenlohnarbeiten&#x22; durchzuführen. Im Abschnitt &#x22;Anzeige/Freigabe von Stundenlohnarbeiten&#x22; ist die Freigabe der Ausführung zu beantragen. Auf dem gleichen Laufzettel ist im Abschnitt &#x22;Stundenlohnzettel&#x22; die Ausführung der Stundenlohnarbeiten zu dokumentieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Nachweis der Stundenlohnarbeiten ist der Objektüberwachung / Fachbauleitung spätestens am der Ausführung folgendem Arbeitstag zur Prüfung und Gegenzeichnung vorzulegen. Das Original verbleibt bei der Objektüberwachung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">/ Fachbauleitung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Als Zuschlag wird:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für Nachtarbeit von 20:00 bis 5:00 Uhr, in Anlehnung an den BRTV 2018, 20 v. H.,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für Arbeit an Sonntagen sowie an gesetzlichen Feiertagen, sofern diese auf einen Sonntag fallen, 75 v. H.,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für Arbeit am Oster- und Pfingstsonntag, ferner am 1. Mai und 1. Weihnachtsfeiertag, auch wenn sie auf einen Sonntag fallen, 200 v. H.,</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">für Arbeit an allen übrigen gesetzlichen Feiertagen, sofern sie nicht auf einen Sonntag fallen, 200 v. H. der jeweiligen Stundensätze gem. den nachfolgenden Positionen vergütet.</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hinweistext Stundenlohnarbeiten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id190" RNoPart="1"><Qty>10.000</Qty><QU>h</QU><UP>55.000</UP><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>091</WCtg><Group>1619</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>9088</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>11</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11100</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2136</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>39</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Stundenlohnarbeiten durch Auszubildende/r (Mittellohn)</span><br/><span>der Verrechnungssatz für die jeweilige Arbeitskraft umfasst sämtliche Aufwendungen wie Lohn- und Gehaltskosten, Lohn- und Gehaltsnebenkosten, Zuschläge, lohngebundene und lohnabhängige Kosten, sonstige Sozialkosten, Gemeinkosten, Wagnis und Gewinn.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auszubildende/r sämtliche Kosten/Zuschläge</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id191" RNoPart="2"><Qty>10.000</Qty><QU>h</QU><UP>65.000</UP><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>091</WCtg><Group>1619</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>9088</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>73</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11100</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2136</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>39</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Stundenlohnarbeiten durch Monteur/-in</span><br/><span>der Verrechnungssatz für die jeweilige Arbeitskraft umfasst sämtliche Aufwendungen wie Lohn- und Gehaltskosten, Lohn- und Gehaltsnebenkosten, Zuschläge, lohngebundene und lohnabhängige Kosten, sonstige Sozialkosten, Gemeinkosten, Wagnis und Gewinn.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Monteur/-in sämtliche Kosten/Zuschläge</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id192" RNoPart="3"><Qty>10.000</Qty><QU>h</QU><UP>85.000</UP><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>091</WCtg><Group>1619</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>9088</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>72</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11100</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2136</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>39</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Stundenlohnarbeiten durch Obermonteur/-in</span><br/><span>der Verrechnungssatz für die jeweilige Arbeitskraft umfasst sämtliche Aufwendungen wie Lohn- und Gehaltskosten, Lohn- und Gehaltsnebenkosten, Zuschläge, lohngebundene und lohnabhängige Kosten, sonstige Sozialkosten, Gemeinkosten, Wagnis und Gewinn.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Obermonteur/-in sämtliche Kosten/Zuschläge</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id193" RNoPart="4"><Qty>10.000</Qty><QU>h</QU><UP>105.000</UP><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>091</WCtg><Group>1619</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>9088</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>183</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11100</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2136</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>39</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Stundenlohnarbeiten durch Projektleiter/-in</span><br/><span>der Verrechnungssatz für die jeweilige Arbeitskraft umfasst sämtliche Aufwendungen wie Lohn- und Gehaltskosten, Lohn- und Gehaltsnebenkosten, Zuschläge, lohngebundene und lohnabhängige Kosten, sonstige Sozialkosten, Gemeinkosten, Wagnis und Gewinn.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Projektleiter/-in sämtliche Kosten/Zuschläge</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id194" RNoPart="5"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><UP>2100.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erstellung der Werk- und Montageplanung durch den Systemhersteller.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">M+W Planung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id195" RNoPart="6"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><UP>2100.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erstellung der Dokumentation durch den Systemhersteller.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dokumentation</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id196" RNoPart="7"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><UP>1050.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Programmierung und Konfiguration des Inspizientensystems nach Nutzervorgaben aus obigen Workshop</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Programmierung und Konfiguration</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id197" RNoPart="8"><Qty>2.000</Qty><QU>t</QU><UP>1018.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schulung der Nutzer des Inspizientensystems im Theater.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schulung und Nutzer Einweisung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id198" RNoPart="9"><Qty>10.000</Qty><QU>t</QU><UP>750.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inbetriebnahme des kompletten Inspizientensystems laut Ausschreibung inkl. eigene Projektkoordination.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inbetriebnahme</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id199" RNoPart="10"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><UP>1500.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Geräte, Werkzeuge und sonstige Betriebsmittel, die zur vertragsgemäßen Erfüllung der Bauleistungen erforderlich sind, auf die Baustelle bringen, bereitstellen und soweit der Geräteeinsatz nicht gesondert berechnet wird, betriebsfertig aufstellen einschließlich der dafür notwendigen Arbeiten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Werkstätten, Lagerschuppen und dergleichen, soweit erforderlich, an- und abtransportieren, aufbauen und einrichten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Leistungsumfang:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erforderliche Maschinen und Geräte</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fördermittel und Hebezeuge</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für den Auftragnehmer erforderliche Container o.ä. für Lagerungszwecke, Aufenthalt, Büro</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Arbeitsgerüste innen und außen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">einschließlich aller Transport- und Verladekosten</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Inhalt:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betrifft die gesamte Anlage mit allen Teilobjekten</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Nicht extra vergütet wird:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Umsetzen von Bauhütten, Materialstapel und dgl. wird nicht besonders vergütet. Der gesamte Baustellenbereich ist gegen unbefugtes Betreten abzusichern.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anzubietende Dauer/ Umfang:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">10 Monate</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einrichten und Räumen der Baustelle, sowie Vorhalten über die gesamte vertraglich vereinbarte Bauzeit hinweg.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Baustelleneinrichtung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id200" RNoPart="11"><Qty>1.000</Qty><QU>Mon</QU><UP>150.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abrechnung pauschal je Monat als Zuschlag oder Abzug zur Pauschale der Vorposition.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mehr-/ Mindermonat Baustelleneinrichtung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id201" RNoPart="12"><Qty>1.000</Qty><QU>t</QU><UP>1018.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erstaufführungen/ Proben/ Aufbauten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Während der ersten Proben-/ Aufbau-/ Aufführungstage ist je ein Systemtechniker Elektrik/ Elektronik abzustellen, um bei betrieblichen Schwierigkeiten oder Störungen dem Bedienpersonal assistieren zu können.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es ist kompetentes, fachkundiges Personal zu stellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Zeitpunkt der erforderlichen Anwesenheit ist mit dem Nutzer abzustimmen. Für die Dauer der Anwesenheit sind mindestens 3, jedoch höchstens 10 Stunden pro Anforderungstag anzusetzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Einheit wird innerhalb dieser Zeitgrenzen als eine Abrechnungseinheit betrachtet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sie umfasst alle anteiligen Nebenkosten wie Fahrtkosten, Übernachtung, Auslösen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stand-By: Teilnahme des Auftragnehmers an Proben und Veranstaltungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id202" RNoPart="13"><Qty>5.000</Qty><QU>St</QU><UP>17.500</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Erstellung eines qualifizierten und aussagekräftigen Berichts je Buchse, mit Zuordnung der Kabelnummer.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zu messen sind mindestens folgende Eigenschaften:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">zertifizierende Messung von CAT6A</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leitungslänge</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dämpfung (für neu verlegte Kabel)</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kupferkabel Dämpfungsmessung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id203" RNoPart="14"><Qty>5.000</Qty><QU>St</QU><UP>15.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Erstellung eines qualifizierten und aussagekräftigen Berichts je Buchse, mit Zuordnung der Kabelnummer.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zu messen sind mindestens folgende Eigenschaften:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Länge</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dämpfung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Funktionsprüfung von 3G-SDI gemäß SMPTE424M</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Koaxialkabel Dämpfungsmessung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>20716.50</Total><TotalGross>24652.64</TotalGross></Totals></BoQCtgy><BoQCtgy ID="id205" RNoPart="14"><LblTx><p><span>NA 01 - MediorNet ­ 25­776  Inspizientenanlage DTG v1</span></p></LblTx><CONo>1</CONo><COStatus>Recog</COStatus><BoQBody><Itemlist><Remark ID="id215"><Description><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">VideoMatrix mit frei konfigurierbarem MultiView</span></p></TextOutlTxt></OutlTxt></OutlineText></Description><CONo>1</CONo></Remark><Item ID="id206" RNoPart="1"><CONo>1</CONo><COStatus>Recog</COStatus><Qty>1.000</Qty><QU>St</QU><UP>2516.800</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">MediorNet MicroN Base Hardware ­ als 4x4 (4MV) Kreuzschiene</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">vorgesehen: RIEDEL MediorNet MicroN Base</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-family:Consolas;font-size:11pt;"><span style="font-family:Consolas;font-size:11pt;">4x4 SDI Video­Router 3G mit 4x frei konfig. MultiView</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id207" RNoPart="2"><CONo>1</CONo><COStatus>Recog</COStatus><Qty>1.000</Qty><QU>St</QU><UP>3198.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;fo