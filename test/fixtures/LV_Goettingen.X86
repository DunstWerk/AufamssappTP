<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA86/3.3"><GAEBInfo><Version>3.3</Version><VersDate>2021-05</VersDate><Date>2026-08-05</Date><Time>21:27:40</Time><ProgSystem>/ GXML Toolbox V3.3 R20220330</ProgSystem><ProgName>ORCA AVA 26.0.8 26.00.08</ProgName><Certific>Available</Certific></GAEBInfo><PrjInfo><NamePrj>25-776</NamePrj><LblPrj>Göttingen Deutsches Theater Inspi</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>86</DP><AwardInfo><Cur>EUR</Cur><CurLbl>Euro</CurLbl><COInfo><CONo>1</CONo><COPhase>SupplAgree</COPhase><COStatus>Recog</COStatus></COInfo><COInfo><CONo>2</CONo><COPhase>SupplAgree</COPhase><COStatus>Recog</COStatus></COInfo></AwardInfo><OWN><Address><Name1>Stadt Göttingen </Name1><Street>Neues Rathaus Hiroschimaplatz 1-4</Street><PCode>00000</PCode><City>Stadt Göttingen</City></Address></OWN><CTR><Address><Name1>Action-Light Veranstaltungstechnik GmbH</Name1><Street/><PCode>00000</PCode><City/></Address></CTR><BoQ ID="id2"><BoQInfo><Name>01</Name><LblBoQ>Inspiziententechnik DTG</LblBoQ><OutlCompl>AllTxt</OutlCompl><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Titel</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Bereich</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn><NoUPComps>4</NoUPComps><LblUPComp1 Type="Wages">Lohn</LblUPComp1><LblUPComp2 Type="Materials">Material</LblUPComp2><LblUPComp3 Type="Plant">Gerät</LblUPComp3><LblUPComp4 Type="Miscellaneous">Sonstiges</LblUPComp4><LblTime>Stunden</LblTime><Totals><Total>198325.75</Total><VAT>19.00</VAT><TotalGross>236007.64</TotalGross></Totals></BoQInfo><BoQBody><BoQCtgy ID="id3" RNoPart="00"><LblTx><p><span>Projekt, Vertragliches, ZTV</span></p></LblTx><BoQBody><Remark ID="id4"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">LEISTUNGSVERZEICHNIS - Medientechnik</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;font-family:Arial;">Bauvorhaben:</span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">Erneuerung Inspizientensystem</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">Deutsches Theater Göttingen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">Theaterpl. 11</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">37073 Göttingen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Deckblatt</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id5"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">A. ALLGEMEINE BAU- UND PROJEKTBESCHREIBUNG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">A. ALLGEMEINE BAU- UND PROJEKTBESCHREIBUNG</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id6"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Baubeschreibung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bei dem Objekt handelt es sich um ein Gebäude im Stiele der Neorenaissance welches als </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Duplikat des Oldenburger Großherzoglichen Hoftheaters im Jahre 1889/90 erbaut wurde. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Architekt Nierenheim erstellte den Bau gemäß den Plänen der Oldenburger Hofbaumeisters </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gerhard Schnitger. Im Jahr 1890 feierte das Stadttheater Göttingen die Neueröffnung. Seitdem </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">wurde das Haus mehrfach renoviert und erweitert. Die letzte Erweiterung war ein Glaspavillon, </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">der 1981-84 nach den Plänen des Göttinger Architekten Jochen Brandi an der Westseite </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">angebaut wurde. Im Theater befinden sich 3 Bühnen, eine im großen Saal, eine kleinere in einem </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Studio, sowie eine Art Bühne im Keller des Theaterkomplexes, wo auch die Bewirtung stattfindet. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im 2. Untergeschoß (UG -4,87) befinden sich Arbeits- Übungs- und Probenräume, sowie </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">haustechnische Bereiche. Diese Art der Räume sind auch im 1. Untergeschoß (UG -2,35) </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">vorhanden. Desweiteren sind im 1. Untergeschoß ein Theaterkeller und gastwirtschaftliche </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Räume untergebracht. Angegliedert an das 1.UG ist eine Tiefgarage mit eine Höhelage zum </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gebäude von - 3,40 Vom EG bis ins 2.OG sind außer dem &#x22;großer Saal&#x22; wiederum Verwaltungs-, </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Arbeits-, Übungs- und Probenräume und dazugehörige haus- und veranstaltungstechnische </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bereiche zu finden. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die erste Bühne &#x22;großer Saal&#x22; bietet für 500 Zuschauer Platz. Sie geht vom EG bis zum 2:OG </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">(2.Rang) Die zweite Bühne des DT, die bis zu 100 Zuschauern Platz bietet, befindet sich im </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">modernen Anbau Als dritte Bühne wird der Theaterkeller genutzt. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Gebäude wurde von 1981-84 erweitert und erneuert. Das ist auch der Stand den der </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hauptteil der haustechnischen Anlagen hat. Einzelne Anlagen oder Teile von Anlagen wurden im </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zuge von Instandhaltung und Reparatur erneuert. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle im Leistungsverzeichnis beschriebenen Postionen beinhalten, wenn nicht anders </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">beschrieben, eine komplette, funktionsfähige Einheit, einschl. Lieferung und Montage. Dazu </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">gehören auch das Herstellen von Medienanschlüssen an Geräten sowie die Prüfung der </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Installation und ggf. ein Probebetrieb. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;"> Es wird darauf hingewiesen, dass für die Ausführung der Arbeiten mit ca. </span><span style="font-size:10pt;color:#FF0000;font-family:Arial;">6</span><span style="font-size:10pt;font-family:Arial;"> Wochen nur ein </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">äußerst begrenzter Zeitraum zur Verfügung steht. (spielfreie Zeit) </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Der AN hat den </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Übersichtsterminplan zur Kenntnis genommen und garantiert mit der Abgabe seines </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">unterschriebenen Angebotes für die Einhaltung dieser Terminplanung.</span><span style="font-size:10pt;font-family:Arial;"> Die mit der </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauleitung während der Bauphase abgestimmten Einzeltermine sind ebenfalls einzuhalten. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auf der Baustelle kann von Montag bis Freitag, in der Zeit von 7:00 - 18:00 Uhr gearbeitet werden. </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">BAUBESCHREIBUNG</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id7"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">B. ANGABEN GEMÄSS DIN 18299 ABSCHNITT 0 (VOB Ausgabe 2019)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Baubeschreibung orientiert sich an der DIN 18299 - Allgemeine Regelungen für Bauarbeiten jeder Art. Die einzelnen Punkte des Abschnitts &#x22;0&#x22; dieser Norm werden im Folgenden (fett gesetzt) wiedergegeben und für die Baustelle beantwortet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">B1. ANGABEN GEMÄSS DIN 18299 ABSCHNITT 0 (VOB Ausgabe 2019)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id8"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0 Hinweis</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">&#x22;Soweit in der Leistungsbeschreibung auf Technische Spezifikationen, z.B. nationale Normen, mit denen Europäische Normen umgesetzt werden, europäische technische Zulassungen, gemeinsame technische Spezifikationen, Internationale Normen, Bezug genommen wird, werden auch ohne den ausdrücklichen Zusatz: &#x22;oder gleichwertig&#x22; immer gleichwertige Technische Spezifikationen in Bezug genommen.&#x22;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0 Hinweis</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id9"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1 Angaben zu Baustelle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1 Angaben zu Baustelle</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id10"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.1 Lage zur Baustelle, Umgebungsbedingungen, Zufahrtsmöglichkeiten und Beschaffenheit der Zufahrt sowie etwaige Einschränkungen bei ihrer Benutzung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Theaterplatz 11, Innenstadt von Göttingen, die Zufahrt zur Baustelle erfolgt über </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">eine Schrankenanlage auf das Parkdeck, im Bereich des Hinterbühneneingangs. Hier </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">können begrenzt Fahrzeuge, nach Absprache mit dem AG während der spielfreien Zeit </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">des Hauses, geparkt werden. </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.1 Lage zur Baustelle, Umgebungsbedingungen, Zufahrtsmöglichkeiten und Beschaffenheit der Zufahrt sowie etw</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id11"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.2 Besondere Bedingungen aus Immissionen sowie besondere klimatische oder betriebliche Bedingungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Arbeiten im laufenden Betrieb:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die eigentliche Teilmaßnahme umfasst den Bereich im Umgriff des Großen Hauses und soll hauptsächlich während der Spielpause 2026 durchgeführt werden. Es sind einige Maßnahmen außerhalb der Spielpause geplant. Diese müssen in enger Abstimmung mit dem Nutzer erfolgen und können ggf. auch Nachts durchgeführt werden. Dabei soll der reguläre Spielbetrieb möglichst wenig gestört werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Brandschutz:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Brandschutzordnung des Theater Göttingen ist zwingend einzuhalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.2 Besondere Bedingungen aus Immissionen sowie besondere klimatische oder betriebliche Bedingungen </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id12"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.3 Art und Lage bauliche Anlagen, z.B. auch Anzahl und Höhe der Geschosse.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Siehe Baubeschreibung oben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.3 Art und Lage bauliche Anlagen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id13"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.4 Verkehrsverhältnisse auf der Baustelle, insbesondere Verkehrsbeschränkungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Parkplätze sind in beschränktem Maße auf dem Parkdeck und in der Tiefgarage    </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">vorhanden. Die Anlieferung erfolgt über die Hinterbühne. (Lieferrampe) </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.4 Verkehrsverhältnisse auf der Baustelle, insbesondere Verkehrsbeschränkungen </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id14"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.5 Für den Verkehr freizuhaltende Flächen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wege für den Personen- bzw. Fahrzeugverkehr außerhalb der Baustelle dürfen nicht durch Bauarbeiten beeinträchtigt</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">werden. Zufahrtswege für Feuerwehr-, Rettungs-, Polizei- und sonstige Hilfsfahrzeuge sind stets freizuhalten. Anderweitige betriebliche Tätigkeiten außerhalb der Baustelle und den Zufahrten dürfen nicht gefährdet werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.5 Für den Verkehr freizuhaltende Flächen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id15"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.6 Art, Lage, Maße und Nutzbarkeit von Transporteinrichtungen und -Wege, z.B. Montageöffnungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Haus sind diverse Aufzüge und Treppenhäuser vorhanden, welche zum Transport </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">genutzt werden können.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.6 Art, Lage, Maße und Nutzbarkeit von Transporteinrichtungen und -wege </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id16"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.7 Lage, Art, Anschlusswert und Bedingungen für das Überlassen von Anschlüssen für Wasser, Energie und Abwasser.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauwasser, Baustrom und andere vorhandene Medien werden vom AG kostenlos zur </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verfügung gestellt. Erforderliche Baustromverteiler und Baubeleuchtung sind vom AN zu </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">liefern und zu unterhalten. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.7 Lage, Art, Anschlusswert und Bedingungen für das Überlassen von Anschlüssen für Wasser, Energie und Abwa</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id17"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.8 Lage und Ausmaß der dem Auftragnehmer für die Ausführung seiner Leistungen zur Benutzung oder Mitbenutzung überlassenen Flächen und Räume</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">nicht erforderlich</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.8 Lage und Ausmaß der dem Auftragnehmer für die Ausführung seiner Leistungen zur Benutzung oder Mitbenutzu</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id18"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.9 Bodenverhältnisse, Baugrund und seine Tragfähigkeit. Ergebnisse von Bodenuntersuchungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nicht notwendig.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.9 Bodenverhältnisse, Baugrund und seine Tragfähigkeit</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id19"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.11 Besondere umweltrechtliche Vorschriften.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Auftragnehmer hat die Maßnahmen zum Schutze der Umwelt in eigener Verantwortung durchzuführen. Allgemein gültige gesetzliche und behördliche Bestimmungen sind zu beachten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.11 Besondere umweltrechtliche Vorschriften</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id20"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.12 Besondere Vorgaben für die Entsorgung, z.B. Beschränkungen für die Beseitigung von Abwasser und Abfall.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Beseitigung von Schutt, Abfall, Verpackungs- und Abdeckmaterial nach VOB/ C DIN 18299 hat von jedem Auftragnehmer arbeitstäglich zu erfolgen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bei der Schuttbeseitigung sind die geltenden Vorschriften des Landes bzw. der Kommune zu beachten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Grundsätzlich sind Verpackungen und Transportpaletten kostenlos gemäß Abfallbeseitigungsgesetz vom AN von der Baustelle zu entfernen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verpackungs-, Restmaterialien sowie Baustellenabfälle sind gemäß der gesetzmäßig vorgeschriebenen Entsorgung zu beseitigen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abfälle sind generell sortenrein in Containern zu sammeln und regelmäßig fachgerecht zu entsorgen. Die entsprechenden Bescheinigungen sind der örtlichen Objektüberwachung vorzulegen. Sollte der Auftragnehmer dieser Verpflichtung nicht nachkommen, so können die Abfälle zu seinen Lasten durch ein anderes Unternehmen entsorgt werden. Kosten für Schuttcontainer sind entsprechend der Leistungsbeschreibung mit den vertraglich vereinbarten Einheitspreisen abgegolten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Verbrennen von Abfällen ist verboten. Farbreste, Säuren, Laugen und sonstige Wasser gefährdende Stoffe dürfen nicht in die Kanalisation geleitet werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anfallendes Material ist grundsätzlich getrennt nach Stofffraktionen von jedem AN eigenständig zu beseitigen/ verwerten, sofern im Leistungsverzeichnis nicht anders beschrieben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.12 Besondere Vorgaben für die Entsorgung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id21"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.14 Art und Umfang des Schutzes von Bäumen, Pflanzbeständen, Vegetationsflächen, Verkehrsflächen, Bauteilen, Bauwerken, Grenzsteinen und dergleichen im Bereich der Baustelle.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Bereich der Baustelleneinrichtungsfläche sind Bäume und Pflanzbestände gemäß Leistungsbeschreibung zu schützen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.14 Art und Umfang des Schutzes von Bäumen, Pflanzbeständen, Vegetationsflächen, Verkehrsflächen, Bauteilen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id22"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.19 Gemäß der Baustellenverordnung getroffene Maßnahmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Ersten Hilfe hat jeder AN nach der Arbeitsstättenverordnung und der Unfallverhütungsvorschriften die notwendigen Vorkehrungen selbst zu treffen. Die Ersthelfer sind dem AG vor Arbeitsbeginn und bei einem Wechsel schriftlich bekanntzugeben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufgrund seiner Verpflichtung nach §2 Abs.1 der Baustellenordnung vom 10. Juni 1998 (siehe hierzu auch http://www.gesetze-im-internet.de/baustellv/index.html) sind bei der Planung der Ausführung eines Bauvorhabens die allgemeinen Grundsätze nach § 4 Arbeitsschutzgesetz zu berücksichtigen. Damit macht der AG die Baustellenordnung zum Bestandteil des Bauvertrages. Sie enthält Regelungen zur Organisation, Koordination und Überwachung des sicheren Baubetriebes und umfasst Maßgaben zur Arbeitssicherheit, die ein unfallfreies Zusammenwirken aller am Bau Beteiligten betreffen. Sie ist auch Bestandteil des Sicherheits- und Gesundheitsschutzplanes.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Jeder AN hat sein Personal über den Inhalt der Baustellenordnung zu unterrichten sowie für die Einhaltung der Maßgaben zu sorgen. Alle Nachunternehmer (auch Lieferanten, etc.) unterliegen der Baustellenordnung und sind von ihren Auftraggebern mit dieser vertraut zu machen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der AN und seine Nachunternehmer hat generell das Arbeitsschutzgesetz vom 7. August 1996 und alle sonst zum Schutz Beschäftigter geltenden Vorschriften einzuhalten. Auf der Baustelle gelten für Arbeitgeber insbesondere  die Arbeitsschutzverpflichtungen, die sich aus § 5 Baustellenverordnung ergeben. Ihre Verantwortlichkeiten zum Schutz der Beschäftigten - insbesondere aufgrund des Arbeitsschutzgesetzes - werden durch die Maßnahmen des AG nicht berührt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle AN haben ihre Leistungen im Sinne des Arbeitsschutzgesetzes, der Unfallverhütungsvorschrift BGV und der Sicherheits- und Gesundheitsschutzbestimmungen zu erbringen. Der Sicherheits- und Gesundheitsschutzplan ist während des gesamten Ausführungszeitraums zu berücksichtigen. Jeder AN ist verpflichtet, seine Arbeiten so zu gestalten, dass eine Gefährdung von Leben und Gesundheit möglichst vermieden wird. Den Hinweisen des vom AG bestellten Koordinators zur Beseitigung von Mängeln bei Sicherheit und Gesundheitsschutz ist unverzüglich nachzukommen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.19 Maßnahmen aus der Baustellenverordnung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id23"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.21 Art und Umfang von Schadstoffbelastungen, z.B. des Bodens, der Gewässer, der Luft, der Stoffe und Bauteile, vorliegende Fachgutachten oder dergleichen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">nicht erforderlich</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.21 Art und Umfang von Schadstoffbelastungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id24"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.1.23 Arbeiten anderer Unternehmer auf der Baustelle.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Während der Ausführung werden Arbeiten anderer Unternehmer auf der Baustelle ausgeführt. Es finden Umbaumaßnahmen an der Elektroverteilung statt. Bei Überschneidungen mehrerer Gewerke erfolgt eine Koordination der Einzelgewerke ausschließlich mit und über die Objektüberwachung/ Fachbauleitung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.1.23 Arbeiten anderer Unternehmer auf der Baustelle</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id25"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2 Angaben zur Ausführung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2 Angaben zur Ausführung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id26"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.1 Vorgesehene Arbeitsabschnitte, Arbeitsunterbrechungen und Arbeitsbeschränkungen nach Art, Ort und Zeit sowie Abhängigkeit von Leistungen anderer.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es ist ein Bauablauf in einer Phase vorgesehen. Dabei muss gewährleistet sein, dass der laufende Betrieb des Theaters nicht gestört wird.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Phase 1 ist während der Spielzeitpause 2026 und betrifft alle ausgeschriebenen Maßnahmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Leistung des ANs erfolgt dem Bauablauf entsprechend. Aufgrund der Abhängigkeit von Vorleistungen, müssen die Leistungen bedarfsorientiert über den vorgesehenen Bauzeitraum ausgeführt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anfahrten für Arbeiten im geringen Umfang, die für den Bauablauf unabdingbar und erforderlich sind, sind mit den vertraglich vereinbarten Einheitspreisen abgegolten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In seltenen Fällen kann es aufgrund des Bauablaufs vorkommen, dass die auszuführenden Leistungen keinen kompletten Arbeitstag füllen. Ein besonderer Vergütungsanspruch besteht hierfür nicht.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bei der Ausführung der Baumaßnahme innerhalb des Bestandes ist grundsätzlich der erhöhte Aufwand für eine abschnittsweise, kleinteilige Ausführung der Arbeiten zu berücksichtigen. Die innerhalb des Gebäudes aufgrund der vorhandenen Bausubstanz vorhandene eingeschränkte Baufreiheit und die logistischen Einschränkungen sind ebenfalls in der Angebotskalkulation zu berücksichtigen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.1 Vorgesehene Arbeitsabschnitte, Arbeitsunterbrechungen und Arbeitsbeschränkungen nach Art, Ort und Zeit s</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id27"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.2 Besondere Erschwernisse während der Ausführung, z.B. Arbeiten in Räumen, in denen der Betrieb weiterläuft, Arbeiten im Bereich von Verkehrswegen oder bei außergewöhnlichen äußeren Einflüssen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es wird ausdrücklich darauf hingewiesen, dass durch die Arbeiten keine Störungen im laufenden Theaterbetrieb auftreten dürfen. Die Arbeitsbereiche sind so aufzubauen, dass keine Staubemissionen in die Umgebung stattfinden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Materialtransporte außerhalb der Sanierungsbereiche dürfen nur in staubdichten Behältnissen / Verpackungen erfolgen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Arbeits- und Verhaltensweisen der Arbeitskräfte und der Einsatz von Geräten sind hierauf abzustellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erschütterungen sind bis auf das Unvermeidliche zu reduzieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lärmbelästigungen sind auf ein unvermeidbares Maß und auf die u. g. Zeitfenster zu beschränken. Das gilt besonders für den Einsatz von Maschinen und Fahrzeugen. Es dürfen nur schallgedämmte Geräte zum Einsatz kommen. Darüber hinaus gelten die im Land Hessen gültigen Vorschriften zum Schutz gegen Baulärm. Der AN ist als Betreiber lärmerzeugender Geräte gemäß Bundes- Immissionsschutzgesetz verpflichtet, diese dem jeweiligen neuesten Stand der Technik anzugleichen, bzw. die entsprechenden lärmdämpfenden Maßnahmen vorzunehmen. Alle erforderlichen Maßnahmen zur Lärmvermeidung sind mit den Einheitspreisen abgegolten. Der beabsichtigte Geräteeinsatz, die Ausführung und der Ablauf ist vor Beginn der Arbeiten mit dem AG abzustimmen. Alle Maschinen und Geräte dürfen innerhalb des Gebäudes nur elektrisch betrieben werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lärmintensive Arbeiten sind abhängig vom Spiel- und Probenbetrieb und sind mit der Objektüberwachung abzustimmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;"><span style="font-size:10pt;font-family:Arial;">Im Regelfall besteht </span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Baufreiheit</span><span style="font-size:10pt;font-family:Arial;"> von 7:00 - 18:00 Uhr, in denen lärmintensive Arbeiten ohne Rücksprache ausgeführt werden können.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In den Zeiten dazwischen sind Abstimmungen mit dem Nutzer und der Objektüberwachung erforderlich.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In den Theaterferien 2026 kann ganztägig lärmintensiv gearbeitet werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Hinweis: Auch an Wochenenden können Arbeiten nur in Abstimmung mit dem Spielplan des Theaters durchgeführt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.2 Besondere Erschwernisse während der Ausführung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id28"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.4 Art und Umfang von Leistungen zur Unfallverhütung und zum Gesundheitsschutz für Mitarbeiter anderer Unternehmen, z.B. trittsichere Abdeckungen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Soweit erforderlich sind Leistungen in der Leistungsbeschreibung erfasst. Die Vorschriften der DGUV sind einzuhalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.4 Art und Umfang von Leistungen zur Unfallverhütung und zum Gesundheitsschutz für Mitarbeiter anderer Unte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id29"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.5 Besondere Anforderungen für Arbeiten in kontaminierten Bereichen, gegebenenfalls besondere Anordnungen für Schutz- und Sicherheitsmaßnahmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">erforderlich Bohrungen sind unter Beachtung der TRGS 519 zu erstellen und mit dem   </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Haustechniker abzustimmen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.5 Besondere Anforderungen für Arbeiten in kontaminierten Bereichen, gegebenenfalls besondere Anordnungen f</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id30"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.6 Besondere Anforderungen Baustelleneinrichtung und Entsorgungseinrichtungen, z.B. Behälter für die getrennte Erfassung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">demontierte Geräte und Anlagen gehen (nach Absprache mit dem Nutzer) in das </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eigentum des AN über und sind ordnungsgemäß zu entsorgen. Ein entsprechender </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Entsorgungsnachweis muss auf Anforderung vorgelegt werden. </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.6 Besondere Anforderungen Baustelleneinrichtung und Entsorgungseinrichtungen </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id31"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.7 Besondere Anforderungen an das Auf- und Abbauen sowie Vorhalten von Gerüsten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für Gerüste und Steighilfen ist der AN verantwortlich.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.7 Besondere Anforderungen an das Auf- und Abbauen sowie Vorhalten von Gerüsten </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id32"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.8 Mitbenutzung fremder Gerüste, Hebezeuge, Aufzüge, Aufenthalts- und Lagerräume, Einrichtungen und dergleichen durch den Auftragnehmer.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">nicht notwendig</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.8 Mitbenutzung fremder Gerüste, Hebezeuge, Aufzüge, Aufenthalts- und Lagerräume, Einrichtungen und derglei</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id33"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.9 Wie lange, für welche Arbeiten und gegebenenfalls für welche Beanspruchung der Auftragnehmer Gerüste, Hebezeuge, Aufzüge, Aufenthalts- und Lagerräume, Einrichtungen und dergleichen für andere Unternehmer vorzuhalten hat.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ist bei Bedarf in den LV-Positionen beschrieben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.9 Wie lange, für welche Arbeiten und gegebenenfalls für welche Beanspruchung der Auftragnehmer Gerüste, He</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id34"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.10 Verwendung oder Mitverwendung von wiederaufbereiteten (Recycling-)Stoffen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nicht vorgesehen, wenn nicht ausdrücklich in der jeweiligen Position aufgeführt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.10 Verwendung oder Mitverwendung von wiederaufbereiteten (Recycling-)Stoffen </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id35"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.11 Anforderung an wiederaufbereitete (Recycling-)Stoffe und an nicht genormte Stoffe und Bauteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nicht vorgesehen, wenn nicht ausdrücklich in der jeweiligen Position aufgeführt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.11 Anforderung an wiederaufbereitete (Recycling-)Stoffe und an nicht genormte Stoffe und Bauteile </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id36"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.12 Besondere Anforderungen an Art, Güte und Umweltverträglichkeit der Stoffe und Bauteile, auch z.B. an die schnelle biologische Abbaubarkeit von Hilfsstoffen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Grundsätzlich dürfen nur neue, unbenutzte Materialien zur Ausführung kommen. Sie müssen den Güte-, Maß- und DIN-Vorschriften oder den Zulassungsbedingungen entsprechen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vom AN sind, auf Verlangen vor Lieferung der Objektüberwachung, Muster der zu montierenden Materialien vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die entsprechenden Zulassungen/Datenblätter sind min. 1 Woche vor Einbau der jeweiligen Materialien der Objektüberwachung zu übergeben. Der Datenaustausch erfolgt in digitaler Form von PDF-Dateien.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der AN sichert den Einbau erprobter, mängelfreier, ungebrauchter und normgerechter Materialien und Baustoffe und deren vorschriftsgemäßen Einsatz zu.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Darüber hinaus ist der AN verpflichtet, ausschließlich umweltfreundliche Materialien, asbestfreie Stoffe, PCP-freie Stoffe und keine entzündlichen oder brandfördernden Gefahrenstoffe einzusetzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Materialien mit krebserzeugenden, erbgutverändernden und fortpflanzungsgefährdenden Inhaltsstoffen sind generell ausgeschlossen soweit dies im Produkt- und Sicherheitsdatenblatt ersichtlich und eine Alternative technisch möglich ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.12 Besondere Anforderungen an Art, Güte und Umweltverträglichkeit der Stoffe und Bauteile </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id37"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.13 Art und Umfang der vom Auftraggeber verlangten Eignungs- und Gütenachweise.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauprodukte (Baustoffe und Bauteile usw.) dürfen nur verwendet werden, wenn der Nachweis über deren Eignung gemäß DIN 18299 erbracht ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.13 Art und Umfang der vom Auftraggeber verlangten Eignungs- und Gütenachweise </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id38"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.14 Unter welchen Bedingungen auf der Baustelle gewonnene Stoffe verwendet werden dürfen oder müssen oder einer anderen Verwertung zuzuführen sind.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewonnene Stoffe sind soweit erforderlich gemäß Leistungsbeschreibung durch den AN fachgerecht zu entsorgen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.14 Unter welchen Bedingungen auf der Baustelle gewonnene Stoffe verwendet werden dürfen oder müssen oder e</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id39"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.15 Art, Zusammensetzung und Menge der aus dem Bereich des Auftraggebers zu entsorgenden Böden, Stoffe und Bauteile, Art der Verwertung oder bei Abfall die Entsorgungsanlage, Anforderungen an die Nachweise über Transporte, Entsorgung und die vom Auftraggeber zu tragenden Entsorgungskosten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anfallende Abbruchmaterialien sind durch den AN zu entsorgen. Der AN trägt alle Gebühren für die Entsorgung sowie die Kosten für den Transport. Die Entsorgungsnachweise der fachgerechten Entsorgung sind unaufgefordert vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.15 Art, Zusammensetzung und Menge der aus dem Bereich des Auftraggebers zu entsorgenden Böden, Stoffe und </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id40"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.16 Art, Anzahl, Menge oder Masse der Stoffe und Bauteile, die vom Auftraggeber beigestellt werden, sowie Art, genaue Bezeichnung des Ortes und Zeit ihrer Übergabe.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Keine Bereitstellung durch den AG vorgesehen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.16 Art, Anzahl, Menge oder Masse der Stoffe und Bauteile, die vom Auftraggeber beigestellt werden, sowie A</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id41"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.18 Leistungen für andere Unternehmer.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sind bei Bedarf in den Vertragsbedingungen bzw. den LV-Positionen beschrieben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.18 Leistungen für andere Unternehmer</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id42"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.19 Mitwirken beim Einstellen von Anlagenteilen und bei der Inbetriebnahme von Anlagen im Zusammenwirken mit anderen Beteiligten, z.B. mit dem Auftragnehmer für die Gebäudeautomation.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mitwirkung bei Abnahmen, Inbetriebnahmen von Bauteilen mit Schnittstellen zu anderen Gewerken und Anforderungen an Sicherheit, Brandschutz, Steuerung u.dgl. wie in den Leistungsverzeichnissen und besonderen Vertragsbedingungen beschrieben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.19 Mitwirken beim Einstellen von Anlagenteilen und bei der Inbetriebnahme von Anlagen im Zusammenwirken mi</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id43"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.20 Benutzung von Teilen der Leistung vor der Abnahme.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Keine Nutzung vor Abnahme vorgesehen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eine Weiterarbeit der Folgegewerke auf der Leistung des AN gilt nicht als Abnahme. Die Leistung wird durch den AG förmlich abgenommen und schriftlich fixiert. Teilabnahmen sind nicht vorgesehen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.20 Benutzung von Teilen der Leistung vor der Abnahme</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id44"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">0.2.22 Abrechnung nach bestimmten Zeichnungen oder Tabellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Abrechnungsunterlagen sind grundsätzlich nach örtlichem Aufmaß des AN bzw. eines gemeinsamen Aufmaßes von AN und der Objektüberwachung des AG für Leistungen nach VOB/B §14(2)  zu erstellen. Gegebenenfalls erforderliche zusätzliche Skizzen und Zeichnungen für die Abrechnung sind vom AN eigenverantwortlich und prüfbar gemäß VOB zu fertigen. Die Abrechnung erfolgt gemäß Arbeitsfortschritt, welcher mittels Aufmaß nachzuweisen ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abschlagsrechnungen, sowie deren Aufmaße und Mengenzusammenstellungen sind ausschließlich kumuliert aufzustellen. In jeder Massenermittlung müssen die Endmassen der vorangegangenen AZ als Zwischensummen dargestellt sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Korrekturen durch die Objektüberwachung im Rücklauf des geprüften Aufmaßes des AN müssen vom AN überprüft und in der nächsten Rechnung im neuen Aufmaß übernommen werden, sofern unstrittig. Pauschale Korrekturzeilen werden nicht akzeptiert. Jede Aufmaßzeile muss mit der entsprechenden AZ, in der sie aufgestellt wurde, gekennzeichnet sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Neben der Einreichung der Rechnungen in Papierform sind die Aufmaßunterlagen zusätzlich in digitaler Form (Datenaustauschformat DA11 oder Excel/OpenOffice-Format .xlsx) zu übermitteln.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abschlagsrechnungen sind fortlaufend zu nummerieren und kumuliert aufzustellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">0.2.22 Abrechnung nach bestimmten Zeichnungen oder Tabellen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id45"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">C. SONSTIGE ANGABEN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die nachfolgend aufgeführten Angaben gelten für alle Leistungen aus diesem Vertrag, sofern in dem Leistungsverzeichnis nicht anders beschrieben. Die aus der Umsetzung dieser sonstigen Angaben entstehenden Kosten werden nicht gesondert vergütet, sondern sind in die Einheitspreise einzukalkulieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">C. SONSTIGE ANGABEN</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id46"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">01 Sicherheits- und Gesundheitskoordinator </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nicht Erforderlich. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">01 Sicherheits- und Gesundheitskoordinator</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id47"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">02 Bauleitung des Auftragnehmers/Fachpersonal</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Fachbauleiter ist schriftlich zu benennen, Nachweise zur beruflichen Qualifikation sind spätestens zwei Wochen vor Ausführungsbeginn vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Firmenbauleiter ist Ansprechpartner der örtlichen Objektüberwachung und verantwortlich für die fachtechnische und termingerechte Ausführung sowie auch für die Einhaltung der Unfallverhütungsvorschriften im Arbeitsbereich des AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Firmenbauleiter muss während der Ausführung auf der Baustelle anwesend sein und hat an den Baustellenbesprechungen teilzunehmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Firmenbauleiter darf nur aus wichtigem Grund ausgetauscht werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aus triftigem Grund kann der AG jedoch den sofortigen Austausch fordern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ein Wechsel des Firmenbauleiters ist rechtzeitig mit entsprechender Begründung anzumelden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Firmenbauleiter, dessen Vertreter oder der Bauführer müssen der deutschen Sprache in Wort und Schrift fließend mächtig sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">02 Bauleitung des Auftragnehmers/Fachpersonal</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id48"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">03 Baustellentagesberichte</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der AN hat dem AG in Form  von Bautagesberichten über den Personal- und Geräteeinsatz, Materiallieferungen, die Arbeitsleistungen, den Arbeitsfortschritt und über besondere Vorkommnisse aktuell zu berichten. Hierzu zählen auch Begehungen mit der Berufsgenossenschaft und dem Gewerbeaufsichtsamt. Dem AG sind alle Unfälle, Erste Hilfe-Fälle und Schadensfälle unverzüglich mitzuteilen. Die Bautagesberichte sind der Objektüberwachung wöchentlich unaufgefordert vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In den Bautagesberichten sind u.a. aufzunehmen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Name der Firma und Baustelle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- fortlaufende Nummerierung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Datum</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Temperatur um 7.00 Uhr (morgens), windgeschützte Stelle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Witterungsverhältnisse</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Anzahl der Arbeitnehmer nach Lohngruppen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Maschineneinsatz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- ausgeführte Leistung mit Ortsangabe (Geschoss/Achsen) und Bezug zum</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">  betroffenen Vorgang (Vorgangsnummer/Planbezeichnung)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- besondere Maßnahmen und Vorkommnisse</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Anweisungen der Objektüberwachung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Unterschrift des Bauleiters des AN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">03 Baustellentagesberichte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id49"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">04 Baustellenbesprechungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der AN hat zu den Baustellenbesprechungen, die durch die Objektüberwachung des AG regelmäßig durchgeführt werden, einen bevollmächtigten Firmenbauleiter zu entsenden. Für diesen besteht Anwesenheitspflicht, bei Abwesenheit ist eine Vertretung zu benennen. Durch das unentschuldigte Nichterscheinen zu den Besprechungen entstehende Nachteile gehen zu Lasten des AN.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Besprechungsergebnisse gelten sofort, d.h. auch ohne Protokoll.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Teilnahme an den Besprechungen bezieht sich auf die Laufzeit der Arbeiten des AN und deren Vorlaufzeit. Die Besprechungen finden jeweils einmal wöchentlich statt. Darüber hinaus sind auch notwendige Besprechungen mit der Objektüberwachung des AG einzuplanen, um die technischen und planerischen Gegebenheiten zu klären, etc.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">04 Baustellenbesprechungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id50"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">05 Termin- und Arbeitsablaufplanung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Grobterminplan:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Start Baustelle: 09.07.2026</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fertigstellung: 30.07.2026</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nach Auftragserteilung jedoch vor Einreichung der Werk- und Montagepläne ist dem AG ein Feinterminplan mit Vorlageterminen, Prüfumlauffristen, Freigabeterminen und Montageterminen vorzulegen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Arbeitsablaufplan ist durch den AN über seine gesamte Bauzeit hinweg fortzuschreiben. Die Detaillierung hat sich dabei auf alle Bauelemente zu beziehen. Der aktuelle Termin- und Arbeitsablaufplan ist stets auf der Baustelle vorzuhalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Diese Leistung wird nicht gesondert vergütet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">05 Termin- und Arbeitsablaufplanung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id51"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">06 Schnittstelle zu Vor- und Folgegewerken</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">nicht notwendig.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">06 Schnittstelle zu Vor- und Folgegewerken</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id52"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">D. DOKUMENTATIONS- UND PLANUNTERLAGEN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">D. DOKUMENTATIONS- UND PLANUNTERLAGEN</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id53"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">01 Dokumentationsunterlagen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die kompletten Dokumentationsunterlagen sind spätestens 1 Woche vor der Abnahme an die Objektüberwachung zu übergeben. Sämtliche Kosten für die komplette Dokumentation sind mit entsprechenden vertraglich vereinbarten LV-Position abgegolten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die schriftlichen Unterlagen sind in Ordnern A4 mit einheitlicher Rückenbeschriftung zu liefern. Ein entsprechendes Muster für das Rückenschild wird dem AN vom AG übergeben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Dokumentation hat nach der nachfolgend angegebenen Reihenfolge zu erfolgen. Sollten einzelne Punkte nicht erforderlich sein, so sind diese Register leer zu führen. Zusätzliche Unterlagen sind in Abstimmung mit der Objektüberwachung des AG entweder als Unterpunkt in die vorgegebene Struktur zu integrieren oder am Ende anzustellen. Die Reihenfolge der Unterlagen ist auch auf dem Datenträger einzuhalten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Reihenfolge Dokumentationsunterlagen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">00. Inhaltsverzeichnis</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">01. Fachunternehmer- und Fachbauleitererklärung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">02. Übereinstimmungserklärungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">03. Prüfzeugnisse, Zulassungen, Zustimmung im Einzelfall</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">04. Einbauvorschriften</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">05. Materiallisten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">06. Produktunterlagen mit Positionsangabe gemäß Leistungsverzeichnis</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">a. Fabrikat</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">b. Modell- und Artikelnummer</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">c. Farbangaben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">d. Materialangaben</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">e. Hersteller und Lieferant</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">f.  Datenblätter</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">g. Einbauhinweise</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">h. Wartungs- und Pflegeanleitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">07. Werkstattzeichnungen inkl. notwendiger Berechnungen mit Verweis auf die Positionsnummer des LV</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">a. Planlisten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">b. stat. Berechnungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">c. Werkstatt- und Montagepläne</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">d. Detailpläne</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">e. Stromlaufpläne, Schemazeichnungen elektr. Bauteile</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">f.  Listen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">g. sonstige Listen (Stahl, usw.)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">08. Bautagesberichte chronologisch sortiert</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">09. Abnahmeprotokoll ggf. mit Mängelliste</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">10. Firmenprotokolle</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">a. Betriebsvorschriften</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">b. Funktionsbeschreibungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">c. Bedienungsanleitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">d. Protokolle zu Leistungen während der Bauzeit</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;tab-stops:75px 151px 226px 302px 378px 453px 529px 604px 680px 756px 831px 907px 982px 1058px;"><span style="font-size:10pt;mso-tab-count:1;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">(Befahren Grundleitungen, Spannen Bauteile, usw.)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">11. CD oder DVD mit Unterlagen 00.-10.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">01 Dokumentationsunterlagen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id54"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">02 Ausführungspläne</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle, dem LV beiliegenden Pläne sind Ausschreibungspläne, welche nicht zur Ausführung freigegeben sind.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle nötigen Ausführungspläne werden digital gemäß VOB/B § 3 vom AG zur Verfügung gestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anhand der Planungsunterlagen hat der AN sofort nach Erhalt der Ausführungsplanung die gesamte Leistung durchzuarbeiten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">02 Ausführungspläne</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id55"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">E. Funktionale Beschreibung der medientechnischen Anlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1 Anforderungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das zu erneuernde Inspizientensystem besteht aus folgenden Teilsystemen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Inspizientenpult</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Steuerzentrale</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Intercom- und Rufanalage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Mithöranlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Bühnen-Kommandoanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Mitschauanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Lichtzeichenanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Schnittstellen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.1 Inspizientenpult</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das bestehende Inspizientenpult besteht aus einem Stahlblechgehäuse, das so breit ist, dass zwei 19-Zoll-Einbauten nebeneinander installiert werden können. Es verfügt weder über eine Höhenverstellung noch über einen Rollladen. Eine genaue Überprüfung ergab, dass es nicht weiterverwendet werden kann. Das neue Gehäuse soll höhenverstellbar sein, um eine optimale Arbeitsumgebung für unterschiedlich große Inspizient:innen zu gewährleisten. Das neue Pult soll mehrere Tastenstreifen für die Ansteuerung von mind. 22 Lichtzeichen, zwei 17&#x22; Mitschaumonitore, einen Touchscreen eine Sprechstelle mit mind. 18 Tasten, zwei Mithörlautsprecher, sowie eine PTZ-Kamera-Steuerung enthalten. Die Anschlussleitung soll möglichst kompakt sein. Die aktuelle Planung sieht 2 Netzwerk- sowie eine Stromleitung vor. Ein Rollo ist aktuell nicht vorgesehen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.2 Steuerzentrale</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die bestehende Steuerzentrale befindet sich in der Unterbühne und besteht aus zwei 19-Zoll-Technikschränken. Dort enden alle wichtigen Schnittstellen und Verbindungen zum Gebäude. Die Schränke können weiterverwendet werden, die Einbauten werden vom Nutzer vor Beginn der Bauphase ausgebaut.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">In der Steuerzentrale werden ein DSP inkl. einer Steuerung des gesamten Systems, eine 10x10 SDI Kreuzschine inkl eines Multiviewers, die Intercom Matrix sowie alle notwendigen Schnittstellen verortet. Diese werden im letzten Absatz genauer beschrieben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.3 Intercom und Rufanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Bestand existiert eine aus ca. 12 Rufkreise bestehende 100V-Lautsprecheranlage mit Havarie-Umschaltung für die Verstärker, mehreren Sprechstellen und einem Funksystem. Das Funksystem soll erhalten bleiben und in die Intercom-Anlage integriert werden. Die ca. 60 bestehenden 100V-Lautsprecher sollen ersetzt werden. Dabei muss jeder Lautsprecher die Möglichkeit haben, zwischen mindestens zwei 100V-Quellen auszuwählen und eine lokale Pegelanpassung ermöglichen. Die Bestandsverkabelung kann weiterverwendet werden. Wo noch keine 100V-Lautsprecherabdeckung vorhanden ist, sollen neue Dante-Lautsprecher (17 St.) mit denselben Funktionen installiert werden. Die bestehende Netzwerk-Verkabelung, inklusive POE, kann dafür verwendet werden. Die 100V-Verstärker inklusive der Havarie-Umschaltung sollen ersetzt werden. Die Leitungswege zu den 100V-Lautsprechern müssen nicht überwacht werden. Die bestehenden Rufkreise sollen wieder realisiert werden. Die Ruf- und Intercom-Anlage sollen über eine USV gepuffert werden, um auch bei Stromausfällen eine Alarmierung zu gewährleisten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusätzlich soll ein neues Intercom-System installiert werden, das aus 4 festen und einer mobilen Sprechstelle (inklusive einer Sprechstelle am Feuerwehr-Angriffs-Punkt), 5 Belt-Packs und 3 Antennen besteht. Die Verkabelung der Sprechstellen und Antennen muss neu erstellt werden. Dies geschieht größtenteils durch das Haus selbst. Teil der Rufanlage soll ein Sprachspeicher sein, der eine Räumungsansage sowie einen Pausengong abspielen kann. Zu beachten ist, dass mit den aktuell berechneten Kosten keine unbegrenzten Audiowege aus der Intercom in die 100V Rufanlage zur Verfügung stehen. Um von einem Beltpack oder einer abgesetzten Sprechstelle in die Rufanlage einzusprechen stehen 2 dynamisch zuweisbare Rufkreise zur Verfügung. Diese Zuweisung erfolgt am Inspizientenpult.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.4 Mithör-/ Schwerhörigen-Anlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Bestand existieren drei Mithör-Mikrofone: ein zentrales Mikrofon, das als Quelle des Mithörsignals dient, sowie zwei Richtmikrofone, die als Quelle für die Schwerhörigen-Anlage verwendet werden. Zukünftig sollen nur noch zwei neue Richtmikrofone verwendet werden, die sowohl für die Schwerhörigen-Anlage als auch das Mithören genutzt werden können. Die vorverstärkten und prozessierten Mikrofonsignale sollen in das Dante-Netzwerk eingespeist werden. Gleichzeitig soll das Line Signal für die bestehende Infrarot-Schwerhörigen-Anlage, die erhalten bleiben kann, im Rack-Schrank in der Unterbühne abrufbar sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.5 Bühnen Kommandoanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Bestand gibt es eine analoge Bühnen-Kommandoanlage, die aus zwei Lautsprechern, welche die Bühne beschallen besteht. Diese Anlage soll mit neuen 100V Lautsprecher erneuert werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.6 Mitschauanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die bestehende Mitschau-Anlage besteht aus zwei Kameras (PTZ und Nachtsicht), einem SDI-Patchfeld als Router, einem Streaming-Konverter und diversen Monitoren, die teilweise noch analog über ein BK-Netz betrieben werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die beiden Kameras sollen durch eine PTZ-Kamera und eine Nachtsicht-Kamera beide mit einem SDI-Ausgang ersetzt werden. Zudem soll eine mobile SDI-Kamera für die Bühnendraufsicht installiert werden, die flexibel im Bereich der Galerie angebracht werden kann. Das vorhandene SDI-Netzwerk kann weitestgehend weiterverwendet werden. Es wird ein kosteneffizienter Router sowie ein neuer Streaming-Konverter (MPEG4) für das Streaming in das EDV-Netz errichtet. Der Router soll über das Inspizientenpult steuerbar sein. Zusätzlich, oder integriert, soll ein 4 zu 1 Multiviewer für einen der beiden Mitschau-Monitore am Inspizientenpult bereitgestellt werden welcher auch auf anderen Mitschaumonitoren abgerufen werden kann. Die bestehenden drei SDI Mitschaumonitore (Fahrpult Bühnentechnik, Fahrpult Eisener Vorhang und im Bereich der Handkonterzüge) im Bühnenbereich können erhalten bleiben. Zudem sollen vier streaming-fähige Monitore installiert werden (Kantine, Aufenthaltsraum Bühnentechnik, Aufenthaltsraum Beleuchtung, Tonstudio), die die dort verbauten analogen Monitore ersetzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Steuerung der PTZ-Kamera soll ebenfalls über das Inspizientenpult erfolgen. Die Verteilung der Videosignale soll mit einer Auflösung von 1080p erfolgen, obwohl einige Komponenten 4K-fähig sind. Zu beachten ist, dass die Videoübertragung möglichst latenzarm geschehen soll.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Kameras werden über neu zu errichtende Medienkästen direkt mit der 10x10 SDI-Routing Matrix in der Zentrale verbunden. Das Routing soll softwareseitig erfolgen, und eine optionale 4. Bestands-Kamera über vorhandene Kabelwege einbinden können.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.7 Lichtzeichenanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Bestand existieren ca. 20 St einfache Lichtzeichen, die über das Zu- und Abschalten von 24V angesteuert werden. Zusätzlich gibt es beleuchtete Taster im Vorderhaus, mit denen das Personal dem Inspizienten signalisieren kann, dass es bereit für die Vorstellung ist. Diese Taster können erhalten bleiben und müssen durch das neue Inspizientensystem angesteuert und angezeigt werden. Die restlichen Lichtzeichen sollen durch einfache, LED-betriebene Lichtzeichen ersetzt werden. Die Steuerung der Lichtzeichen soll über Tastenstreifen im Inspizientenpult erfolgen. Diese sollen dynamisch in der Belegung angepasst werden können. Eine Ablaufsteuerung ist aktuell nicht vorgesehen. Die Bestandsverkabelung kann weiterverwendet werden. Dabei ist zu beachten, dass die neuen Lichtzeichen an der Bestand-Tuchel-Buchse angeschlossen werden muss. Es sollen zwei zusätzliche Funk-Lichtzeichen in das System eingebunden werden. Diese können mit dem Bestands-W-Lan betrieben werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.8 Schnittstellen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Folgende Bestands-Schnittstellen sollen wiederhergestellt werden:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Analoge Audio-Schnittstelle zur Schwerhörigen Anlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Schnittstelle zur BMA zur Anzeige eines Brandalarmes</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Schnittstelle zu einem mechanischen Pausengong</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- MPEG4-Streaming eines Mitschausignals in das EDV-Netz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Folgende neue Schnittstellen sollen etabliert werden:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Dante Schnittstelle des Intercom-Systems in das EDV-Netz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Dante Schnittstelle in das Netzwerk Ton</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- OSC-Schnittstelle zu BB-Mischpult (ETC) zur Anzeige der aktuellen Lichtstimmung am Inspizientenpult</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Funk-Schnittstelle vom Intercom-System zum bestehenden Motorola Funksystem</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1.9 Infrastruktur</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Zuge der geplanten Erneuerung der Inspizientenanlage sind folgende Maßnahmen erforderlich:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Versatzkästen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusätzlich zu den Bestands-Versatzkästen, welche weiterverwendet werden, müssen einige neue errichtet werden. Diese sollen lt. AK-Liste bestückt werden. Größtenteils werden die dafür notwendigen Leitungen vom Theater neu errichtet und gemessen übergeben. Die Lichtzeichen werden an die Vorhandenen Anschlüsse gesteckt. Dafür müssen alle Lichtzeichen mit Tuchel-Stecker bestückt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Verkabelung der neuen IP-Lautsprecher kann die Bestands-Netzwerk-Verkabelung genutzt werden. An den notwendigen Stellen sind Anschlussbuchsen inkl. POE vorhanden. Zusätzlich ist eine QV vom Bestands-Netzwerk-Raum zu dem Inspizienten-Rack zu errichten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Patchfelder:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die teilweise durch das Haus neu zu verlegenden Leitungen für Video und Intercom in dem Technik-Rack werden über Steckfelder zugänglich gemacht. Hierbei werden Steckfelder für Cat.6A RJ45 und BNC 75 Ohm verwendet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Leitungen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Einvernehmen mit dem Bauherren installiert ein vom Nutzer beauftragter Elektrofachbetrieb ausgewählte Cat  und SDI Leitungen für die Intercom Anlage. Die Installation ist vor Baubeginn der Inspizientenanlage abgeschlossen; alle Leitungen enden im Technikschrank Unterbühne, werden auf RJ45 Keystone Module aufgelegt und inklusive Dämpfung messtechnisch protokolliert. Diese Module sind durch den AN in das neu zu errichtende Patchfeld zu integrieren. Dabei ist auf eine durchgängige Beschriftung zu achten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusätzlich müssen folgende Kabel und Leitungen verlegt werden:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Datenkabel Cat.7 für eine Kamera am Rang</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- BNC-Leitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Stromleitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Netzwerk:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Netzwerk soll grundsätzlich nicht redundant aufgebaut werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Verlegesysteme:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es wird erforderlich sein, Bestandskabeltrassen zu öffnen, um Leitungen zu demontieren und neu zu verlegen. Nach Abschluss der Arbeiten müssen die Trassen wieder geschlossen werden. Es wird auch notwendig sein, bestehende Kabelrinnen, Stahlpanzerrohre, Kabelkanäle und Sammelhalter zu ergänzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Des Weiteren sind Arbeiten zur Herstellung neuer Bohrungen und Durchbrüche sowie zum Öffnen und Wiederverschließen vorhandener Durchbrüche notwendig. Nach der Kabelverlegung müssen diese Öffnungen brandschutzgerecht verschlossen werden. Während der Bauphase in der Spielzeit könnten auch temporäre Brandschottungen und Brandschutzkabelkanäle erforderlich sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle BMA:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Um ein Brandereignis am Inspizientenpult anzeigen zu können, muss es eine Schnittstelle zur BMA geben. Diese wird durch den Bauherren in den Technikzentralen mittels Koppler errichtet.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">E. Funktionale Beschreibung der medientechnischen Anlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id56"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">F. Kalkulatorischer Hinweis für das gesamte LV</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für alle Positionen dieses Leistungsverzeichnisses, außer De- und Remontagen, sind alle Kosten für nachfolgend gelistete/s Leistung/Material mit einzukalkulieren, sofern nicht separat ausgeschrieben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lieferung einschließlich allem erforderlichen Zubehör und zusätzlich benötigten Kleinteilen (wie u.a. Schrauben, Dübel, LSA + Leisten, Rangierwaben, kurze Patchkabel, etc.).</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle dafür benötigten Werkzeuge, außer gesondert ausgeschrieben.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vertragen auf der Baustelle bis zum Verwendungsort.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Entsorgung der Verpackung und Materialreste.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufstellen und Montieren einschließlich aller erforderlichen Befestigungs-, Zugentlastungs- und Isolationsteile.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschließen. Dies beinhaltet auch das Spleißen von LWL-Kabeln.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die gesamte interne Verkabelung, mit eingeführten Kabeln, sofern nicht in Sonderfällen als eigene Position geführt.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Anschlusskabel einschließlich aller Verbindungs- und Netzkabel sowie Anschlussstecker oder ggf. Klemmen, die für den Erstbetrieb benötigt sind.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fachgerechter Schutz vor Verschmutzung oder Beschädigung bis zur Abnahme.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stecker, Kabel und Buchsen inklusive beständiger Beschriftung.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Software inkl. aktueller Updates/Patches installiert, Gerät nach Hersteller- und/oder Nutzervorgaben konfiguriert und eingerichtet (wie bspw. Preseterstellung), sofern nicht separat ausgeschrieben.</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">F. Kalkulatorischer Hinweis für das gesamte LV</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id57"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">G.  Abkürzungsverzeichnis</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">AG - Auftraggeber</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">AN - Auftragnehmer</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ELT - Elektrotechnik</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">FMT - Fernmeldetechnik</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">LV - Leistungsbeschreibung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">M+W - Montage- und Werkstattplanung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">MK - Medienanschlusskasten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">MT - Medientechnik</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ZTV - Zusätzliche Technische Vertragsbedingungen</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">G. Abkürzungsverzeichnis</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id58"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">H. Installationrichtlinie</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die hier enthaltenen Angaben gelten als Installationsrichtlinie. Bei widersprüchlichen Angaben ist einvernehmlich eine Lösung zu realisieren, die den Forderungen dieser Installationsrichtlinie möglichst nahe kommt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1. Qualifikation des Personals</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Montagen sind von qualifiziertem Fachpersonal durchzuführen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">2. Vorleistungsprüfungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Falls bauseitige Vorleistungen für Installationen, also z.B. Schlitze, Durchbrüche, Trassen oder Leitungen, vorliegen bzw. vorliegen müssen, sind diese vor Beginn der eigenen Tätigkeit, gegebenenfalls in Teilabschnitten, auf vollständige und ordnungsgemäße Ausführung zu prüfen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">3. Kabelwege</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Führung von Kabeltrassen, Leitungen und Kabeln hat auf den in der Planung dargestellten Wegen zu erfolgen. Aufgrund besonderer Gründe erforderliche abweichende Kabel- und Leitungswege sind mit der Bauleitung und den betroffenen Gewerken abzustimmen. Verkabelungen zu Endgeräten, Endverrohrungen und Leitungen zu Einzelanschlüssen sind in der Regel nicht in der Planung dargestellt und müssen vom Auftragnehmer nach Maßgabe dieser Angaben eigenständig, in Zweifelsfällen in Abstimmung mit der Objektüberwachung, festgelegt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">4. Berührungsschutz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">An dieser Stelle wird nochmals besonders auf die gültigen Vorschriften verwiesen (ohne dass andere Regelungen davon berührt werden). Der Schutz des Nutzers der Anlage steht an oberster Stelle.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">5. Versorgung NSUV</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die NS-Versorgungsnetze der Medientechnik sind von den anderen Netzen wie Haustechnik, Beleuchtung, Bühnentechnik usw. getrennt auszuführen. Dazu sind eigene Netz-Unterverteilungen vorgesehen, die gesondert abgesichert von der Niederspannungs-Hauptverteilung (NSHV) gespeist werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das medientechnische Versorgungsnetz ist mit einer eigenen Funktionserde auszustatten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">6. Montagehöhen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eine Einbringbarkeit von Steig-/Hubhilfen ist im jeweiligen Fall rechtzeitig vor Montagebeginn mit dem AG und der Bauleitung abzustimmen. Die aus dem Bauablauf resultierenden normalen Einschränkungen durch z.B. Estrich- oder Bodenverlegarbeiten beim Einbringen und Herausholen von Steig- und Hubhilfen sind zu berücksichtigen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">7. Befestigung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für die Befestigung an bauseitigen Stahlkonstruktionen sind geeignete und zugelassene Klemmbefestigungen einzusetzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">8. Tragsysteme</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Befestigung/Verbindung der Tragsysteme untereinander und am Gebäude sind einheitliche und durchgängig zertifizierte Systemzubehörteile zu verwenden, soweit nicht ausdrücklich andere Befestigung vorgeschrieben ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">9. Durchbrüche, Bohrungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Durch Durchbrüche und Bohrungen sind keine Tragsysteme durchzuführen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">10. Durchbrüche mit brandschutztechnischen Anforderungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Werden Kabel und Leitungen über oder durch Wände/Decken/Böden mit brandschutztechnischen Anforderungen geführt, so sind besondere Installationsvorgaben einzuhalten, die gewährleisten, dass Brandschutzabschottungen im Auftragsumfang des AN zulassungskonform durchgeführt werden können.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">H. Installation</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id59"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">I. Prüfungen der verlegten Kabel und Leitungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Gewährleistung und Dokumentation der Qualität der installierten Kupfer- und Glasfaserkabel und -leitungen sind deren technische Daten eindeutig und ausführlich aufzunehmen. Diese Leistungen sind in separaten LV-Positionen ausgeschrieben.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">I. Prüfungen der verlegten Kabel und Leitungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id60"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">J. Einweisungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Personal des Nutzers ist durch einen qualifizierten Mitarbeiter des Errichters, als Teil der Abnahme, in die Anlage einzuweisen. Bei der Einweisung sind die Funktionen aller Komponenten der Anlage, die Anwendung und Bedeutung von abgespeicherten Grundeinstellungen anhand der Dokumentation zu erläutern, an der Anlage zu demonstrieren und in Grundzügen einzuüben. Es ist in die Fehlererkennung, die Fehlerbehebung und den Austausch von Verschleißteilen einzuweisen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erläuterungen sind anhand von vorbereiteten Plänen, Übersichtsblättern, Listen und Anleitungen durchzuführen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">J. Einweisungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id61"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">K. Geräte</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1. Prüfzeichen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle medientechnischen Anlagenteile müssen, soweit für diese zutreffend, alle erforderlichen Prüfzeichen tragen. Diese sind u.a. VDE-Prüfzeichen, GS-Prüfsiegel, Prüfzeichen des BAPT, CE-Prüfzeichen etc.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Geräte ohne ein entsprechendes Prüfzeichen und/oder Schutzklasse 0 werden nicht akzeptiert.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">2. Lieferumfang/Anschlüsse</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Jegliches im originalen Lieferumfang des Produkts beigelegte Zubehör ist dem AG bei der Übergabe der Anlage sortiert und bei größeren Mengen gekennzeichnet auszuhändigen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">K. Geräte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id62"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">L Farben, Beschriftung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">1 Farbgebung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dem AG ist zur Abstimmung und rechtzeitig vor Errichtung bzw. Montage der Anlagenteile eine Liste mit vorgesehenen Farbtönen (beispielsweise in Form einer Tabelle mit RAL-Tönen) vorzulegen. Sofern nicht anders beschrieben sollen alle Geräte in Matt-Schwarz RAL 9011 geliefert werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">2 Beschriftung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle medientechnischen Anlagenteile sind dauerhaft zu beschriften. Dies Beschriftung ist in Form, Größe und Systematik der Nummerierung mit dem AG abzustimmen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">L. Farben, Beschriftung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id63"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">M. Einheitlichkeit der Bauteile, Typenänderung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die angebotenen Produkte sind über das gesamte LV weitestgehend - sofern sinnvoll und einhaltbar - einheitlich zu wählen. Produktlinien sind stets zu bevorzugen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bis zum Bauzeitende auslaufende Gerätetypen dürfen nicht verwendet werden. Sind angebotene Geräte nicht mehr lieferbar, ist mit dem Auftraggeber und der Fachplanung ein Ersatztyp abzustimmen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">M. Einheitlichkeit der Bauteile, Typenänderung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id64"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">N. Schließsystem</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">nicht notwendig</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">N. Schließsystem</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id65"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">O. Normen und Vorschriften</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die gesamte medientechnische Anlage ist so zu errichten, dass sie allen gültigen Normen, Richt- und Leitlinien, Sicherheitsbestimmungen und Empfehlungen entspricht. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">O. Normen und Vorschriften</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id66"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">STLB-Bau 10/2020 099</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Soweit in der Leistungsbeschreibung auf technische Spezifikationen, z. B. nationale Normen, mit denen Europäische Normen umgesetzt werden, europäische technische Zulassungen, gemeinsame technische Spezifikationen, internationale Normen, Bezug genommen wird, werden auch ohne den ausdrücklichen Zusatz: oder gleichwertig, immer gleichwertige technische Spezifikationen in Bezug genommen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">P. gleichwertige technische Spezifikationen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id67"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für die nachstehend beschriebenen Leistungen sind Muster, nach Aufforderung durch den AG, vor Ausführung zur Genehmigung vorzulegen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Q. Muster vorlegen vor Ausführung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id68"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Bauleitung verwendet für die Dokumentation der Durchbrüche, sowie die Verwaltung notwendiger Informationen die Software docutools (vgl. www.docu-tools.com).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Diese stellt für das Projekt die zentrale Plattform zur Baudokumentation, Aufgabenkoordination und Projektkommunikation, dar. Der AN verpflichtet sich, sämtliche baulichen Prozesse in docutools zu bearbeiten. Dazu wird ihm ein und/oder mehrere kostenlose Accounts zur Verfügung gestellt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Workflow, welcher verpflichtend für den AN dabei einzuhalten ist, sieht folgende Schritte für jeden Durchbruch in docutools vor:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Informationenentnahme sämtlicher Durchbrüche und ihre Beschaffenheiten</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aufgabenstellung und Rückinformation an andere ANs zur Durchführung von Vorleistungen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bearbeitung des Durchbruchs</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dokumentation vorgenommener Änderungen, bestehender Eintragungen/Informationen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Foto-Dokumentation des geschlossenen Durchbruchs</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Foto-Dokumentation des Ausführungsschildes neben dem Durchbruch</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Markieren des Durchbruchs als &#x22;Geschlossen&#x22;, sobald alle Arbeiten abgeschlossen sind.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ferner ist der AN verpflichtet, docutools zur allgemeinen Baudokumentation, Mängelverfolgung (auch schon während des Bauablaufs), Klärung von Schnittstellen mit anderen Beteiligten und weiteren Aufgaben einzusetzen. Dazu ist folgender Ablauf vorgesehen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mangel/ Aufgabe/ sonstiger Pin wird durch Bauleitung erstellt (Text und/oder Foto)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dieser wird dem AN zugewiesen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:482pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der AN erledigt diesen und markiert ihn als erledigt. ggf. mit textlicher und/oder fotografischer Erläuterung</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">R. Dokumentationssoftware docutools</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id69"><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>099</WCtg><Group>5955</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>9457</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>404</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18839</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18809</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18810</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18811</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>21722</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18812</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18813</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18814</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18815</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18816</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18817</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18819</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18877</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18820</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>19126</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18821</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18822</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18823</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>19127</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18824</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18825</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18826</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18827</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18828</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18829</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18830</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18831</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18832</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>18833</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>19132</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>19133</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>19134</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Im Leistungsverzeichnis können folgende Abrechnungseinheiten zur Anwendung kommen:</span><br/><span>h = Stunde,</span><br/><span>d = Tag,</span><br/><span>Wo = Woche,</span><br/><span>Mt = Monat,</span><br/><span>a = Jahr,</span><br/><span>cm = Zentimeter,</span><br/><span>cm2 = Quadratzentimeter,</span><br/><span>m = Meter,</span><br/><span>m2 = Quadratmeter,</span><br/><span>m3 = Kubikmeter,</span><br/><span>l = Liter,</span><br/><span>St = Stück,</span><br/><span>kg = Kilogramm,</span><br/><span>t = Tonne,</span><br/><span>mh = Meter x Stunde,</span><br/><span>md = Meter x Tag,</span><br/><span>mWo = Meter x Woche,</span><br/><span>mMt = Meter x Monat,</span><br/><span>ma = Meter x Jahr,</span><br/><span>m2d = Quadratmeter x Tag,</span><br/><span>m2Wo = Quadratmeter x Woche,</span><br/><span>m2Mt = Quadratmeter x Monat,</span><br/><span>m3d = Kubikmeter x Tag,</span><br/><span>m3Wo = Kubikmeter x Woche,</span><br/><span>m3Mt = Kubikmeter x Monat,</span><br/><span>Sth = Stück x Stunde,</span><br/><span>Std = Stück x Tag,</span><br/><span>StWo = Stück x Woche,</span><br/><span>StMt = Stück x Monat,</span><br/><span>td = Tonne x Tag,</span><br/><span>tWo = Tonne x Woche,</span><br/><span>tMt = Tonne x Monat.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Standardbesch Abrechnungseinheiten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id70"><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>099</WCtg><Group>3597</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>9457</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>224</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>12771</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>5</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>12770</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>12768</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>3</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>12769</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>4</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>7577</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Dem AN werden nach Auftragserteilung unentgeltlich zur Verfügung gestellt:</span><br/><span>Ausführungs- und Grundrisspläne sowie Schnittzeichnungen der Baumaßnahme,</span><br/><span>Schlitz- und Durchbruchpläne.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Standardbesch unentgeltliche Unterl. Ausführ./Grundrisspläne Schnittzeich. Schlitz- Durchbruchpläne</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Remark ID="id71"><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2020-10</VersDate><WCtg>099</WCtg><Group>1441</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>10291</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10292</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10288</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>6</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>7574</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>8</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10289</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>6</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10290</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>39</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10293</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>3</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10294</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10295</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>3</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Erstellung der Montagezeichnungen mit CAD-Programm auf Basis der vom AG zur Verfügung gestellten Baupläne des Objektplaners und der Ausführungszeichnungen der Anlagen der TGA als Plotterausdruck/Papierzeichnung und auf Datenträger/Schnittstelle. Schnittstelle DWG, Betriebssystem MS Windows 10, Datenübertragung über ISDN,</span><br/><span>Organisation und Verwaltung des Datenaustausches, Layerstrukturen und Zeichnungsebenen durch AG,</span><br/><span>Ausführung gemäß Einzelbeschreibung.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:595pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Standardbesch Montagezeichnung CAD durch AG gestellte Baupläne Ausführungszeichnungen DWG ISDN</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark></BoQBody><Totals><Total>0.00</Total></Totals></BoQCtgy><BoQCtgy ID="id72" RNoPart="01"><LblTx><p><span>Netzwerktechnik</span></p></LblTx><BoQBody><Itemlist><Remark ID="id73"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die bestehende EDV-Netzwerkinfrastruktur wird um zusätzliche Komponenten erweitert und über eine Querverbindung mit der neuen Zentrale des Inspizientensystems in der Unterbühne verbunden. Dadurch wird die Spannungsversorgung ausgewählter Endgeräte über PoE/PoE+ und eine Kommunikation mit dem neu zu errichtenden Netzwerk ermöglicht.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Zentrale des Inspizientensystemes und das EDV Netzwerk befinden sich in der Unterbühne in vorhandenen 19&#x22;-Rackschränken. In diesen wird auch die Steuerzentrale des Inspizientensystems mit Audio-DSP, SDI-Routing und Streamingtechnik installiert wird.  Die Einbindung in das vorhandene Hausnetz erfolgt über eine neu herzustellende Querverbindung vom bestehenden IT-Netzwerkschrank zum Inspizienten-Rack.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Über das EDV-Netz werden neue PoE-fähige IP-/Dante-Ruflautsprecher betrieben, die unter anderem das Vorderhaus, Foyer- und Aufenthaltsbereiche versorgen.  Zudem wird ein MPEG4-Streaming-Encoder eingesetzt, um das zentrale Mitschausignal als Videostream in das Datennetz zu speisen und auf geeigneten, streamingfähigen Monitoren im Gebäude bereitzustellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Anbindung der Endgeräte erfolgt leitungsgebunden über strukturierte Kupfer-Datenkabel (Cat.6A/Cat.7) auf RJ45-Patchfeldern in den Technik- und Netzwerkschränken. Die neu zu verlegenden Leitungen werden messtechnisch geprüft, protokolliert und im Technikschrank aufgelegt.?</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für das vorliegende Projekt sind nur die Datenleitungen vom Inspizientenpult, zur medientechnischen Zentrale in der Unterbühne und einer Kamera am Rang neu zu errichten. Sämtliche weiteren Netzwerkleitungen zu den Endgeräten im Gebäude werden durch die vorhandene Hausverkabelung oder bauseitig hergestellte Vorleitungen bereitgestellt und sind nicht Bestandteil dieser Leistung.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vortext</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id74" RNoPart="1"><Qty>1.000</Qty><QU>St</QU><UP>2194.200</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerk Switch</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Formfaktor:			1HE</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Switching Kapazität:		bis 680 Gbps</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Modulare Ports:			8 Stück</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RJ45 Ports:			0 Stück</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RJ45 Ports inkl. PoE+:	40 Stück</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PSU:				1x fixed</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Redundantes Netzteil:		Ja</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lüftung:				Aktiv, bis 35dB</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Konsolen-Ports:			1x</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kompatibilität mit umgebender Netzwerkinfrastruktur. Insbesondere unterstüzung für Dante-Steams. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerk Switch, 40+8 Ports, PoE+</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id75" RNoPart="2"><Qty>1.000</Qty><QU>St</QU><UP>591.100</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerk Switch</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Formfaktor:			1HE</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Switching Kapazität:		bis 680 Gbps</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Modulare Ports:			2 Stück</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RJ45 Ports:			0 Stück</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RJ45 Ports inkl. PoE+:	8 Stück</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PSU:				1x fixed</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Redundantes Netzteil:		Ja</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lüftung:				Aktiv, bis 35dB</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Konsolen-Ports:			1x</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kompatibilität mit umgebender Netzwerkinfrastruktur. Insbesondere unterstüzung für Dante-Steams.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerk Switch, 8+2 Ports, PoE+</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>2785.30</Total><TotalGross>3314.51</TotalGross></Totals></BoQCtgy><BoQCtgy ID="id76" RNoPart="02"><LblTx><p><span>Inspizientenanlage</span></p></LblTx><BoQBody><BoQCtgy ID="id77" RNoPart="01"><LblTx><p><span>Pult</span></p></LblTx><BoQBody><Itemlist><PerfDescr ID="id78"><PerfNo>1</PerfNo><PerfLbl>Ausführungsbeschreibung</PerfLbl><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Aufbau des Pultes soll modular erfolgen. Nicht genutzte Einbaubereiche sind durch Blindplatten abzudecken es ist ein 19&#x22;-Montagesystem einzusetzen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Frontflächen der Einbauplatten sind zweigeteilt. Mindestens der untere Teil der Einbauflächen (min. 7HE) soll zur besseren Bedien- und Lesbarkeit um ca. 30° zum Inspizienten hin geneigt sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die max. Abmessungen des Pults sind ca: 1100 x 2100 x 530 (BxHxT)mm, zuzüglich einer Schreibauflage.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausstattung mit 4 stabilen, feststellbaren Rollen mit Kunststofflaufflächen, davon 2 St. als Lenkrollen ausgeführt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Schreibauflage ist ein stabiles Schreibbrett (Stärke ca. 25mm), ca. 110 x 45 cm. Unter der Schreibauflage ist mindestens eine Einbauschublade zu intallieren. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Gerätefronten und das Schreibbrett müssen beleuchtet werden. Die Beleuchtung ist als LED-Band in das Pultgehäuse zu integrieren und Bestandteil dieser Position. Die Pultbeleuchtung muss in der Helligkeit regelbar sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Pult ist für stehenden und sitzenden Betrieb auszulegen. Demzufolge ist der Aufbau unterhalb der Schreibplatte motorisch verfahrbar auszuführen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Höhenunterschied zwischen sitzender und stehender Bedienung soll ca. bis zu 50cm betragen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für Signal- und Stromversorgung verfügt das Pult an der Rückseite des Gehäuses über eine bühnentaugliche, integrierte Steckvorrichtung, jeweils ein Stromanschluss (max. 10A, 230V). eine Signalübetragung für Netzwerk und VIdeo. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Desweiteren sind insbesondere auch die folgenden Einheiten in das Pult einzubauen und zu integrieren:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PoE Ethernet-Switch (26-Ports, nicht Bestandteil dieser Position, siehe Rechnersysteme) für</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">die Anbindung der ausgeschriebenen Intercom-Sprechstelle</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">zur Auskopplung des Dante Audiosignals und</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">zur Ansteuerung des zu integrierenden Camera-Remotecontrollers</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausführungsbeschreibung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></PerfDescr><Item ID="id79" RNoPart="1"><LumpSumItem>Yes</LumpSumItem><RefPerfNo IDRef="id78"/><Qty>1.000</Qty><QU>psch</QU><UP>26032.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fertigung, Lieferung und Integration eines hochfunktionalen Inspizientenpults für Theater- und Bühnenbetrieb, als maßgefertigte Sonderkonstruktion mit nachstehenden Funktionen und Ausstattungsmerkmalen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1. Gehäuse, Bauform und Ergonomie</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Individuell gefertigtes Gehäuse aus hochwertigem Korpusmaterial, seidenmatt lackiert in Standard-RAL-Farbe.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximale Breite: 1,2m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Motorische Höhenverstellung, stufenlos; optional: programmierbare Positionen in Szenen abrufbar.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rückwand abnehmbar für optimierten Servicezugang.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ablageflächen inkl. integrierter Partiturablage, Stiftablage, </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2. Beleuchtung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Integrierte LED-Beleuchtung für die Arbeitsfläche und Bedienelemente.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schwanenhalsleuchten für Arbeitsflächenbeleuchtung, regelbar.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3. Bedienoberfläche und Tastenmodule</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauraum für Tastenmodul. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Individuell gefertigte Frontplatten inklusive individueller Beschriftung. Die Frontplatten sind Rückseitig mit den Tastenmodule bestückbar und können im Service- und Änderungsfall einfach ausgetauscht werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Optional modulare Frontplattenkonfiguration mit bis zu 2 x 09 HE im 19&#x22;-Format.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zugriffskontrolle über PIN-Eingabe wahlweise mit Schlüsselschalter, optional per RFID</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4. Display- und Visualisierungsfunktionen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einbauraum für:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- Touchdisplay mit mind. 21,5&#x22;.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- 2x Displays mit mind. 21,5&#x22;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">5. Kommunikations- und Intercom-Integration</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">19&#x22;-Einbauplatz (3 HE) zur Aufnahme vorhandener Intercom-Systeme von Drittherstellern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nahtlose Anbindung an bestehende Intercom-Infrastrukturen sowie bereits im LV ausgewiesene Intercom-Schnittstellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Steuerung und Signalisierung der Intercom über die Systemfunktionen des Pultes und Tastenmodule.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom-Bedienmodul am Pult mit Headset-/Schwanenhalsmikrofon-Anschluss sowie integrierten Monitorlautsprechern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Pegelsteller für Lautstärke von Headset und Lautsprechern mit integrierter Mute-Anzeige. Umschaltung zwischen Headset und Lautsprecher/Schwanenhals inklusive Status-Anzeige.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ausgabe von Durchsagen, Gong, Pausen- und Warnhinweisen über die interne Steuerlogik.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">6. Audio-, Video- und Netzwerk-Integration</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mitschau-Funktionalität über mehrere SDI-Eingänge und -Ausgänge; HDMI optional.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vorbereitung für AV-over-IP-Strukturen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ein-Kabel-Multicore-Anbindung für kombinierte Netz-, Steuer- und AV-Signale und Strom zwischen Pult und abgesetzter Steuereinheit mit folgenden Funktionen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">AV-Switching für Video- und Steuersignale</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mindestens 3× SDI-In / 3× SDI-Out</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mindestens 4× Analoge Audio-Ausgänge, erweiterbar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlußmöglichkeiten für Anbindung DANTE und Artnet/SACN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerk-Integration für Steuer- und Rückmeldesysteme</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inspizientenpult (höhenverstellbar)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id80" RNoPart="2"><Qty>2.000</Qty><QU>St</QU><UP>720.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vorschau- und Monitoring-Displays in Full HD zur Anzeige externer Videoquellen (z. B. Bühnenkamera, Saalkamera, Mitschau-Signale gemäß LV-Position &#x22;Mitschauen&#x22;, Status-Display).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildschirmdiagonale: mind. 21&#x22;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auflösung: 1920 x 1080 (FHD)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kontrast: 1000:1</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Helligkeit: 1000 cd/qm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Videoanschlüsse: </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- HDMI Input (2160p)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">- 3G-SDI</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mechanische Halterung: VESA 100 x 100 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Bildschirm ist inklusive Halterung bzw. fest montiert zu liefern.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildschirm 21&#x22; FHD HDMI SDI inkl. Halterung und Wandler</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id81" RNoPart="3"><Qty>1.000</Qty><QU>St</QU><UP>1386.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Touch Screen PC-Controller, frei programmierbar über zentrale Steuereinheit. Touchscreen-Bedienfeld für Setup, Routing, Szenensteuerung, Statusanzeigen und Abläufe. Einbau in 19&#x22; Rackschien. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">GUI Software für Inspizientensystem on Board. </span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">21&#x22; Touch Screen Controller für Steuerung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id82" RNoPart="4"><Qty>1.000</Qty><QU>St</QU><UP>630.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">aktiver 2-Kanal Audio-Monitorlautsprecher</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mind. 2 Pegelsteller für verschiedene Audiosignale</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">angeschlossen an internen DSP</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Mikrofoneingang für Intercom und Durchruffunktion</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. hochwertigem Schahnenhals-Mikrofon</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Möglichkeit über angeschlossenen DSP einen Dante-Stream Abzuhören</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">aktive Lautsprecher mit Lautstärkesteller und Mikrofon</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id83" RNoPart="5"><Qty>1.000</Qty><QU>St</QU><UP>525.000</UP><Description><CompleteText><DetailTxt><Text><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">6x Multifunktionstasten, Belegung Kameraauswahl</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3-achsiger Joystick incl. &#x22;hall effect&#x22; zur verfeinerten Steuerung der Kameras.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Signalversorgung und Anschluss über PoE.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkfähiger Controller zum wahlweisen Steuern der PTZ-Kameras.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vollständig kompatibel zu allen hier ausgeschriebenen remote-steuerbaren Kameras</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PTZ Kamera Remote Controller inkl. Joystick</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id84" RNoPart="6"><Qty>4.000</Qty><QU>St</QU><UP>1050.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Tastenmodule mit bis zu 16 Tastern, </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bauform: 19&#x22;-Modulbreite, zur Integration in modulare 19&#x22;-Frontplatten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">16 hochwertige, mechanische Taster (taktiles Feedback), programmierbarer LED-Hinterleuchtung mit darüberliegender Textanzeige zur dynamischen Beschriftung der jeweiligen Taste.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Individuell gefertigte Frontplatte inklusive individueller Beschriftung, Vorbereitung für Einbau in individuelle 19&#x22;-Frontplatten, mechanische Befestigungspunkte kompatibel zu modularen Inspizientenpultsystemen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einzelkanalsteuerung der LED-Signalisierung für Betriebszustände, Warnungen oder Funktionsaktivierung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einbindung in bestehende Steuer-, Inspizienten- oder Panel-Logik,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zuordnung der Funktionen über die zentrale Steuerungsplattform konfigurierbar.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">16er Tastenblock mit dynamisch beschriftbaren Tasten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id85" RNoPart="7"><Qty>1.000</Qty><QU>St</QU><UP>375.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fertig konfektionierte, flexible und mechanisch widerstandsfähige Anschlussleitung inkl. aller notwendiger Kommunikations und Stromleitungen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlussleitung Hybrid 10m</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>34588.00</Total></Totals></BoQCtgy><BoQCtgy ID="id86" RNoPart="02"><LblTx><p><span>Zentrale</span></p></LblTx><BoQBody><Itemlist><Item ID="id87" RNoPart="1"><Qty>1.000</Qty><QU>St</QU><UP>250.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bereitstellung einer Software-/Systemerweiterung zur Erweiterung der Steuerfähigkeiten eines medientechnischen DSP-Steuersystems um das Open-Sound-Control-Protokoll (OSC). Die Erweiterung dient der Einbindung, Fernsteuerung und Zustandsabfrage externer Geräte, Anwendungen oder Medienprozesse. Anforderungen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">OSC-Kommunikation: Unterstützung von bidirektionaler Kommunikation über UDP-basierte OSC-Nachrichten zur Steuerung und Rückmeldung von externen Geräten, Software-Clients oder Automationssystemen. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Adressierung &#x26; Struktur: Frei konfigurierbare OSC-Adresspfade zur Anpassung an unterschiedliche Zielsysteme, inkl. Unterstützung mehrerer paralleler Endpunkte.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Steuerlogik: Vollständig integrierbare OSC-Befehle in die vorhandene Steuerlogik des Systems, inkl. Trigger, Presets, Szenenabrufe und Statusmonitoring.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Integration in das Gesamtsystem: Einbindung in bestehende Steuerungsabläufe, Medienautomation und Raum-/Veranstaltungsszenarien; kombinierbar mit anderen Protokollen wie GPIO, IP-Befehlen oder seriellen Triggern.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zielsetzung: Erweiterter Funktionsumfang des DSP-Steuersystems, um Drittgeräte oder Softwareprozesse medientechnisch zu integrieren, zu steuern und dynamisch zu verknüpfen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzeige der Lichtsteuercues auf dem Inspizientenpult</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">OSC Schnittstelle BB</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id88" RNoPart="2"><Qty>1.000</Qty><QU>St</QU><UP>184.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle BMA als potentialfreier Kontakt, welche von einem BMA-Koppler angesteuert werden kann.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es ist keine Überwachung gefordert.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Schnittstelle soll zum einen der Signalisierung eines Brandes verwendet werden und zum anderen um das Mithörsignal bei einem Brandereignis zu muten.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle BMA</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id89" RNoPart="3"><Qty>1.000</Qty><QU>St</QU><UP>184.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle mechanischer Gong als potentialfreier Kontakt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Schnittstelle soll zum an- und Ausschalten des mechanischen Gogsignals verwendet werden. Dafür kann es notwendig sein, dass zusätzlich eine Gleichspannung zur Verfügung gestellt werden muss. Diese Spannung ist Teil dieser LV-Position.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle mechanischer Gong</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id90" RNoPart="4"><Qty>1.000</Qty><QU>St</QU><UP>184.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle schaltberer Strom als potentialfreier Kontakt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Schnittstelle soll zum an- und Ausschalten von 230V AC verwendet werden.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle NSUV</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id91" RNoPart="5"><Qty>1.000</Qty><QU>St</QU><UP>2013.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anbindung des zentralen Audiosteuerungssystems zur Bereitstellung von Audioströmen für den LV-Bereich &#x22;Mithören&#x22;. Routing und Steuerung: </span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Möglichkeit zur flexiblen Signalverteilung, Zuweisung und Priorisierung über die bestehende Steueroberfläche des Systems; Integration in Szenen, Presets und Automationsabläufe.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkbetrieb: Unterstützung von Multicast- und Unicast-Strömen, Verwaltung von Clock-Synchronisation sowie stabiler Betrieb in gemischten IT-Umgebungen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Latenz &#x26; QoS: Konfigurierbare Paketlatenzen, Unterstützung von QoS-Mechanismen zur priorisierten Audioübertragung in komplexen Netzwerken.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlussvielfalt: Mehrere physikalische Netzwerkanschlüsse zur getrennten oder redundanten Nutzung, z. B. für Steuer- und Audio-Netzwerke, zur Erhöhung der Betriebssicherheit.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Systemintegration: Steuerung und Monitoring über die zentrale Plattform, Nutzung von Routing- und Metering-Funktionen sowie Bereitstellung von Statusmeldungen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erweiterung des DSP-Systems: Aktivierung zusätzlicher Audiostream-Ein- und Ausgänge sowie Netzwerkschnittstellen zur Ausspielung der Signale für den LV-Bereich &#x22;Mithören&#x22;.</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einbindung eines Audio-Netzwerkprotokolls </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">(Dante-kompatibel) </span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id92" RNoPart="6"><Qty>1.000</Qty><QU>St</QU><UP>4986.000</UP><Description><CompleteText><ComplTSA>Yes</ComplTSA><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lieferung und Einrichtung einer abgesetzten Steuerzentrale als vollwertige Steuerungs- und Überwachungseinheit des Inspizienten- und Bühnensystems. Die Einheit dient als zentraler Zugriffspunkt für Steuerung, </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Statusabgleich und Ablaufkontrolle und erfüllt mindestens folgende Funktionsmerkmale:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einsatz einer integrierten Full-Stack-AV-Plattform für Steuerung, Logik, Routing, Monitoring des Pults und seiner Peripherie.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Systemsteuerung aller relevanten Inspizienten-, Kommunikations- und Signalkomponenten über Netzwerk.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anbindung der Bedienoberfläche des Pultes für Setup, Routing, Statusanzeigen, Tastenmodulen, Ablaufsteuerung sowie die Verwaltung von Durchsagen, Signalen und Meldungen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anbindung an Intercom- und Durchrufsysteme, einschließlich der im Projekt vorgesehenen Schnittstellen und vorhandenen Kommunikationsgeräte.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ansteuerung der Mitschau-/Mithör-Funktionen, einschließlich der im LV beschriebenen Video- und Audio-Signalpfade.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übernahme der Statusinformationen des Gesamtsystems zur zentralen Anzeige von Betriebszuständen, Warnungen und Fehlern; optional Remote-Monitoring.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkbasierte Kommunikation mit allen angeschlossenen Endpunkten, inklusive AV-Signalverarbeitung, Steuerung und Rückmeldungen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Optionale Einbindung mobiler Endgeräte (z. B. Tablet/Smartphone), falls im Hauptsystem vorgesehen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sichere Zugang Passwort- oder PIN-basiert, wenn von der Hauptkonsole gefordert.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Montagefähigkeit als 19&#x22;- oder 9,5&#x22;-Einheit in Technik- oder Regieracks.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Einheit ist vollständig kompatibel mit den in den LV-Positionen Inspizientenpult, Mithören, Mitschauen, Intercom sowie Anbindung Dante/Streaming beschriebenen Komponenten und Systemen. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Erweiterbarkeit und Update-Fähigkeit für zukünftige AV-over-IP-Strukturen.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Inklusiver oder zusätzlicher Audio DSP mit folgenden Eigenschaften:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4 x Audioein- oder -ausgänge zur Integration externer Mikrofone, Lautsprecher, Intercom-Signale und weiterer AV-Quellen bzw. -Senken.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4 x 8 GPIO-Ein- und Ausgänge zur Anbindung von Tastern, Schaltkontakten, Signalisierungen und Steuerfunktionen des abgesetzten Bedienbereichs.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x Endstufenausgänge mind. 5W/4Ohm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x RS232 Control</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkfähige Einbindung in die bestehende AV-Steuerungsarchitektur mit konfigurierbaren Parametern für Routing, Pegel, Logik-Verknüpfungen und Statusabfragen. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Latenzoptimierte Verarbeitung der Signale innerhalb des Systems, geeignet für zeitkritische Steuer- und Audioanwendungen wie Intercom, Warnsignale oder Ablaufsteuerungen. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audiospeicher zum abspielen von mind. 3 Audiodateien wie Gong und Räumungsansage auf die Rufanlage.  </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">QoS-konforme Übertragung im AV-/IT-Netzwerk zur Priorisierung von Echtzeit-Audio und Steuerprozessen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Flexibel konfigurierbare Signalpfade zur Anpassung an künftige Erweiterungen oder veränderte Pult-/Steuerungsanforderungen.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Angebote </span><span style="font-size:10pt;font-family:Arial;">(vom Bieter einzutragen)</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Owner"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Fabrikat: </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;QSYS&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="12" Kind="Owner"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ: </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;Core 24f&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zentrale Steuerungseinheit und Audio DSP</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>7801.00</Total></Totals></BoQCtgy><BoQCtgy ID="id93" RNoPart="03"><LblTx><p><span>Dienstleistungen</span></p></LblTx><BoQBody><Itemlist><Item ID="id94" RNoPart="1"><Qty>2.000</Qty><QU>t</QU><UP>1018.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Workshop zur Erarbeitung Pflichtenheft mit Nutzern</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dieser Workshop erfolgt zusammen mit maximal 5 Nutzern im Theater. Der Termin ist eng mit dem Nutzer in ausreichendem Abstand zur Errichtung abzustimmen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Workshop zur Erarbeitung Pflichtenheft mit Nutzern</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>2036.00</Total></Totals></BoQCtgy></BoQBody><Totals><Total>44425.00</Total><TotalGross>52865.75</TotalGross></Totals></BoQCtgy><BoQCtgy ID="id95" RNoPart="03"><LblTx><p><span>Intercomanlage</span></p></LblTx><BoQBody><Itemlist><PerfDescr ID="id96"><PerfNo>2</PerfNo><PerfLbl>Vortext Intercom</PerfLbl><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Regieräume (siehe Lagepläne) erhalten fest zugeordnete Auftisch-Sprechstellen mit Mikrofon und Lautsprecher. Des Weiteren wird eine Mobile Steckstellle im Saal realisiert, an welcher eine Sprechstelle für den Probenbetrieb nach bedarf angeschlossen werden kann. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sprechstellen müssen zum Beispiel über die IP-Adresse eindeutig gekennzeichnet sein, sodass die Intercomanlage die Sprechstelle automatisch erkennt, sobald diese im Haus angesteckt wird.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Sprechstellen sollen in einer Geräusch-sensiblen Umgebung betrieben werden. Aus diesem Grund sollten sie im Normal-Betrieb keine oder nur sehr geringe Störgeräusche produzieren.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Techniker auf oder hinter der Bühne erhalten tragbare &#x22;Beltpacks&#x22;, also am Gürtel tragbare Geräte. Zu den Beltpacks werden komfortabel tragbare Headsets verwendet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Beltpacks sollen als digitales drahtloses Intercomsystem auf DECT-Basis ausgeführt werden. Die Antennen werden auf einfache Weise per CAT-Leitung entweder direkt oder über Netzwerkswitche des Audio-Netzwerkes mit der Basisstation verbunden. Pro Antenne sollen mindestens 10 Beltpacks betrieben werden können.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Basisstation wird in die drahtgebundene Intercom so eingebunden, dass eine uneingeschränkte Integration der drahtlosen Beltpacks in das digitale Matrixsystem möglich ist.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Um die Reichweite oder die Anzahl der Beltpacks in einem Bereich zu erhöhen, können weitere Antennen platziert werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Beltpacks werden per &#x22;Auto-Roaming&#x22; unterbrechungsfrei von Antenne zu Antenne übergeben, wenn der Empfangsbereich einer Antenne verlassen wird.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Systemanforderungen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Jeder Kanal ist vollduplexfähig</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Endgeräte sind für die geforderte Kanalzahl vollduplexfähig</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Zentrale ist für die Einspielung externer Signale und die Ausspielung zu externen Senken geeignet</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Anlagen sind Party-Line-fähig (d.h. es können mehrere Teilnehmer gleichzeitig auf einen Kanal zugreifen). Dadurch können z.B. alle Beleuchter gleichzeitig die Kommandos der Zentrale mithören und bei Bedarf durch Betätigung der Sprechtaste Rückmeldungen/ Rückfragen absetzen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Als Übertragungsmedium zur Anbindung der Sprechstellen dient eine CAT7-Leitung mit RJ45-Anschlüssen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Matrix Frame soll über Dante an das Audio Netzwerk des Hauses angebunden werden.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Endgeräte verfügen über eine optische Rufanzeige, die über eine spezielle Ruftaste an einer Gegenstation auslösbar ist</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Knackfreies Umschalten zwischen den Kanälen</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leicht bedienbare Software-Konfiguration der Anlage, die auch vom AG eigenständig verändert werden können muss.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Fernwartungmöglichkeit muss gegeben sein.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gute Audio-Signalqualität, Übertragunsbereich (mind. 300 Hz bis 7kHz)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RF-Abdeckung im Freihen (freie Sichtlinie) mind. 150m</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Beltpacks verfügen über die üblichen Intercom-Funktionen und -Eigenschaften:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kompaktes Gehäuse mit Gürtelclip</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Headset-Anschluss</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betrieb mit Akkupack.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Akkupack sowohl im Beltpack eingesetzt als auch einzeln separat herausnehmbar in Ladestation aufladbar!</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Es sind folgende Schnittstellen zu bestehenden Anlagen zu realisieren:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstelle zur Ruf- und Mithör-Anlage über eine Audio-Verbindungen (Dante). Die Auslösung der Rufe erfolgt über IP-Kommandos, serieller Schnittstelle oder über GPI-Steuerkontakte (Bedienung über die Intercom-Sprechstellen in den Inspizientenpulten). Je Bühne werden hierfür bis zu 12 Rufkreise definiert. Bei der Konfiguration dieser Sprechstellen ist diese Anforderung zu beachten und umzusetzen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eine Schnittstelle zum bestehenden Motorola DP1400 funksystem mit 2 Simplex fähigen Kanälen. </span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vortext Intercom</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></PerfDescr><Item ID="id97" RNoPart="1"><Qty>1.000</Qty><QU>St</QU><UP>8449.430</UP><Description><CompleteText><ComplTSA>Yes</ComplTSA><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom Frame passend zu in Systembeschreibung beschriebenem Intercom-System.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">19&#x22;/ 2 HE Intercom Frame mit 10 Einschubplätzen für die in Folgeposition beschriebenen Interface Karten. Der Frame stellt bei Vollbestückung bis zu 1.024 nicht blockierende bidirektionale Ports zur Verfügung und verfügt über mehrere unabhängige Sync Domains.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 (zwei) Steckplätze sind reserviert für Router- und NetzwerkInterface Karten. Die Interface Karten der weiteren 8 (acht) Steckplätze können für unterschiedliche Kommunikationsstandards (AES67/ SMPTE 2110-30/31, MADI, ab 2023 Dante)konfiguriert werden. Alle Karten sind im laufenden Betrieb austauschbar (Hot-Swap).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Datenverbindungen und die Steuerlogik des Frames sind entsprechend SMPTE 2022-7 redundant ausgelegt. Das Lüftermodul verfügt über 2 redundante Lüftereinheiten. Es stehen 2 redundante Netzteile zur Verfügung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Frame verfügt über ein E-Ink Display und einen Drehregler. Bei Bedarf kann die Kühlung vorne-hinten oder hinten-vorne ausgeführt werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Einschubplätze:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x Router/ Netzwerk Karten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">8 x Interface Karten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Ports:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">16 bis 1.024 pro Frame/ Node (nicht blockierend/ bidirektional)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bedienelemente (frontseitig):</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x E-Ink Display</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Drehregler</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Redundanz:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">CPU/ NIC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x Glasfaserring</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">N +1</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">SMPTE 2022-7</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x PSU</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Strom:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eingangsspannung: 100 - 240 VAC, 50/60 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistung: max. 225 W / &#x3c;770BTU/h/ max. 2,3 A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (B x H x T): 19&#x22; x 2 HE x max. 410 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 6,5 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">180° rotierbar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Montage-Offset: 0 mm/ 25 mm/ 50 mm/ 75 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Betriebsumgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: 0° bis +45°C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Luftfeuchtigkeit: 20% bis 90 % (nicht kondensierend)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Max. Höhe: 3000 m über NHN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frame liefern, betriebsfertig montieren und anschließen inkl. aller notwendigen Kleinteile, inkl. Konfigurationssoftware, Lizenzen, Installation der Software und Erstkonfiguration, Programmierung und Anpassung nach Vorgaben des Planers/ Nutzers.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Angeboten </span><span style="font-size:10pt;font-family:Arial;">(vom Bieter einzutragen)</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Owner"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Fabrikat: </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;RIEDEL&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="12" Kind="Owner"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ: </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;Artist-1024&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom 19&#x22; Gehäuse</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id98" RNoPart="2"><Qty>3.000</Qty><QU>St</QU><UP>2706.610</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Interface-Karte zur Montage in Vorposition beschriebenen Frame. Die Funktion der Karte wird über eine spezielle proprietäre Konfigurationssoftware definiert, die es dem Nutzer erlaubt, die Karte für folgende Anwendungen zu konfigurieren:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">SMPTE 2110-30/31</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">MADI</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dante</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Prozessor-/ Router-/ Fiber</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">9 (neun) Status-LEDs geben Auskunft über folgende Betriebszustände:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Status der Karte</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Upstream-/ Downstream Qualität</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Upstream-/ Downstream Link</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ethernet Aktivität</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ethernet Link</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betrieb</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Karte verfügt über einen integrierten Mischer, der von 8 bis 128 bidirektionalen Kanälen/ Ports skalierbar ist und auf  bis zu 1.024 Kanäle zugreifen kann. Die Karte unterstützt interne Sample-Rate Konvertierung, jede Karte kann an eine jeweils andere Taktumgebung angeschlossen werden, im MADI Modus auch an zwei verschiedene MADI Takte.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Ports:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">8 bis 128 pro Karte (nicht blockierend/ bidirektional)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x SFP</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x RJ 45</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Konnektivität:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">SMPTE 2110-10-30/-31</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">SMPTE 2110-30 (Level A, B, C)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">SMPTE2022-7:2019</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">IEEE 1588:2008</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">ST-2059-2 / Media Profile / AES R16</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">IGMPv3 / SSM</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">JT-NM TR-1001:1</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">NMOS IS-04 / -05</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">DHCP</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">DNS</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Strom &#x26; Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Spannung: 12 VDC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistung: 13 W / 44 BTU/h (typ.) bis 20 W / 68 BTU/h 8max.)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 300 g</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Karte liefern, in Frame betriebsfertig montieren, anschließen und konfigurieren, inkl. aller notwendigen Kleinteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Universelle Interface Karte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id99" RNoPart="3"><Qty>3.000</Qty><QU>St</QU><UP>119.850</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstellen Transceiver Modul passend für in Vorposition beschriebenes Interface Karte.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Anforderungen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse: Duplex LC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Multimode</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstellen Modul</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id100" RNoPart="4"><Qty>1.000</Qty><QU>St</QU><UP>2037.450</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Konfigurationssoftware für in Vorposition beschriebenes Intercom.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Windows basierte Software für Zugang, Konfiguration und Kontrolle des Systems und dessen Funktionalität. Die Konfiguration kann online oder offline geschehen. Die Software muss nicht installiert, sondern lediglich auf den Rechner kopiert werden. Die Software bietet einen vollständigen Überblick über den Systemzustand. Ein System kann konfiguriert werden mit bis zu 500 Konferenzen/ 500 Gruppen/ 1500 IFBs. Alle internen Routing- und DSP-Aspekte jeder Sprechstelle eines Systems können aus der Ferne konfiguriert werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Verwaltung und Überwachung des Intercom-Systems können bis zu 4 (vier) PCs pro Node/ Frame angeschlossen werden. Die Verbindung erfolgt über den Ethernet Port der Nodes/ Frames. Alle angeschlossenen PCs können gleichzeitig das System überwachen und ggfs. Konfigurationsänderungen vornehmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Software gestattet es, verschiedene Ebenen der Systemverwaltung zu erstellen und somit unterschiedliche Zugriffsrechte zu verteilen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Grundeinstellung und die vollständige Konfiguration des Systems werden sowohl in den einzelnen Nodes/ Frames als auch auf den angeschlossenen PCs abgelegt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Neben der Konfiguration von z.B. Sprechstellen und Tastern ermöglicht die Software auch deren Fernsteuerung. Alle in der Software konfigurierten Funktionen können auch ferngesteuert werden, ebenso die Lautstärken der angeschlossenen Panels.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Software ermöglicht Echtzeit-Audiopegelanzeigen für alle Eingänge des Systems. Eine Echtzeit-Koppelpunkt-Ansicht ermöglicht es dem Systemadministrator zu sehen, welche Rufe im System aktiv sind und wodurch sie ausgelöst werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zur Gewährleistung des korrekten Betriebs der Software wird die Nutzung eines PCs mit folgenden Mindestvoraussetzungen gefordert:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Windows 10 (oder aktueller)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intel® Core i5-Prozessor oder ähnlich (4 Kerne, 2.5 GHz CPU-Frequenz), entsprechend Systemanforderungen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4 GB RAM verfügbar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3 GB freier Speicherplatz auf der Festplatte</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildschirmauflösung von min. 1920 x 1200 mit 16Bit Farbtiefe</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maus und Tastatur</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkadapter (LAN-Verbindung muss das TCP/IP-Protokoll und eine Bandbreite von 100 Mbit Vollduplex oder automatische Erkennung unterstützen)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Software auf PC aufspielen, an System anschließen, konfigurieren und in Betrieb nehmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Konfigurationssoftware</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id101" RNoPart="5"><Qty>1.000</Qty><QU>St</QU><UP>1767.790</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">19&#x22;/ 1 HE Intercom Sprechstelle mit 3 (drei) Multi-Touch-Farbdisplays und 18 (achtzehn) Tastern und multifunktionaler und applikationsgesteuerter Benutzeroberfläche passend unten beschriebener Matrixplattform. Die Sprechstelle ist über digitale Audio- und Datenverbindungen mit der Matrix verbunden und unterstützt AES3, AVB und ST2110-30/31 (AES67) Konnektivität. Die Sprechstelle unterstützt 2-Kanal Konnektivität mit der Matrix.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Sprechstelle verfügt über ein internes Netzteil, einen Lautsprecher und unterstützt 2 (zwei) Headsets. Es stehen 3 (drei) lokale GPI Inputs, 3 (drei) lokale GPI Outputs, 2 (zwei) analoge 4-Drähte zur Verfügung sowie eine interne Audiomatrix und interne Audioprozessoren (EQ, Kompressor, Limiter).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Sprechstelle kann von der Konfigurations-Software aus fernbedient werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Sprechstelle verfügt über 3 (drei) vollfarbige Touchscreen-Displays, einen Dreh-Encoder und 18 (achtzehn) plus 3 (drei) Taster. Die Displays stellen pro Taster 8 (acht) plus 16 (sechzehn) Zeichen zur Verfügung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse frontseitig:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Mikrofon, 6,3 mm, female</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x XLR-4M Headset</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse rückseitig:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x PSU male</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x PSU female</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Sub-D female (GPI)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Sub-D male (GPO)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x RJ-45 Expansion</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x HDMI</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x RJ-45 Ethernet/ AES67/ AVB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x SD Karten Slot</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x RJ-45 (Analog I/O)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x RJ-45 Headset</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x RJ-45 (Matrix) - optional</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x BNC (Matrix) - optional</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bedienelemente frontseitig:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">18 x Taster</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Dreh-Encoder</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3 x Funktions-Taster</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bildschirm:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3 frontseitige Multi-Touch-Farbdisplays</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Audio:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (internes Mic): 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (Headset Mic): 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (Headset Hörer): 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (interner Speaker): 120 Hz  16,6 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audio I/O 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sample Rate: 48 kHz/ 24 Bit</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Umgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: 0° - 45°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 20 - 90% (nicht kondensierend)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (B, H, T): 19&#x22;, 1 HE, max. 80 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 2 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Strom:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Spannung: 100  240 VAC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verbrauch: ≤30 W, ≤30 BTU/hr</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sprechstelle liefern, betriebsfertig installieren, anschließen und konfigurieren, inkl. aller notwendigen Kleinteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">IP-Sprechstelle, 18 Tasten, 19&#x22; 1HE Format</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id102" RNoPart="6"><Qty>1.000</Qty><QU>St</QU><UP>359.550</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom-Applikation passend zu in Vorposition beschriebener Sprechstelle/ Nutzer-Interface.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Intercom-Applikation aktiviert 18 (achtzehn) Intercom Tasten, individuelle Lautstärkeneinstellung, AES67/AVB und Ethernet Konnektivität, Headset und USB Anschlüsse,</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Software Intercom-Applikation liefern, installieren, konfigurieren und in Betrieb nehmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Software Intercom-App</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id103" RNoPart="7"><Qty>6.000</Qty><QU>St</QU><UP>209.740</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">30 cm Schwanenhals Elektret-Mikrofon mit Nierencharakteristik, passend zu in Vorposition beschriebener Sprechstelle.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Allgemein:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Typ: Elektret</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Funktionsprinzip: Druckgradient</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Richtcharakteristik: Niere</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang: 30 Hz  19 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Empfindlichkeit: 10 mV / Pa ±2 mV</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennimpedanz: ca. 2 kΩ</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lastimpedanz: &#x3e;10 kΩ</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Max. SPL: 120 dB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Rauschabstand: &#x3e;60 dB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschluss:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stecker: 6,35 mm Klinke</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Umgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: -10° - +55°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 20 - 90% (nicht kondensierend)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Länge: 340 mm (inkl. Stecker)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: 110 g</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Windschutz (L × ø): 50 × 25 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mikrofon liefern, betriebsfertig installieren und anschließen, inkl. aller notwendigen Kleinteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schwanenhals Elektret-Mikrofon</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id104" RNoPart="8"><Qty>7.000</Qty><QU>St</QU><UP>364.540</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Headset für in Vorposition Beltpacks und Sprechstelle.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Anforderungen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">geschlossene Ausführung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzbereich Kopfhörer: 10 - 30.000 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">schwenkbarer Mikrophonarm (ca. 270°)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzbereich Mikrofon: 40 - 12.000 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlusskabel: 4-pin XLR-female</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Farbe: schwarz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 300 g</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Headset liefern, testen und an Nutzer übergeben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Headset</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id105" RNoPart="9"><Qty>3.000</Qty><QU>St</QU><UP>2397.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom Tischsprechstelle und Nutzer-Interface mit 2 (zwei) Multi-Touch-Farbdisplays und 12 (zwölf) Tastern und mit multifunktionaler und applikationsgesteuerter Benutzeroberfläche passend zu beschriebener Matrixplattform. Die Tischsprechstelle ist über digitale Audio- und Datenverbindungen mit der Matrix verbunden und unterstützt AES3, AVB und ST2110-30/31 (AES67) Konnektivität. Die Tischsprechstelle unterstützt 2-Kanal Konnektivität mit der Matrix.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Tischsprechstelle verfügt über ein internes Netzteil, einen Lautsprecher und unterstützt 2 (zwei) Headsets. Es stehen 3 (drei) lokale GPI Inputs, 3 (drei) lokale GPI Outputs, 1 (ein) analoger 4-Draht zur Verfügung sowie eine interne Audiomatrix und interne Audioprozessoren (EQ, Kompressor, Limiter).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Tischsprechstelle kann von der Konfigurations-Software aus fernbedient werden. Sie verfügt auf der Unterseite über ein ¼&#x22; Gewinde.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Tischsprechstelle verfügt über 2 (zwei) vollfarbige Touchscreen-Displays, einen Dreh-Encoder und 18 Taster. Die Displays stellen für jeden Taster 8 (acht) plus 16 (sechzehn) Zeichen zur Verfügung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse frontseitig:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Mikrofon, 6,3 mm, female</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse rückseitig:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x PSU male</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x RJ-45 Ethernet/ AES67/ AVB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Sub-D female (GPI)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Sub-D male (GPO)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x XLR-4M Headset</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x SD Karten Slot</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x BNC (Matrix)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x RJ-45 (Matrix)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x RJ-45 (Analog I/O)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x USB</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bedienelemente frontseitig:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">12 x Taster</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Dreh-Encoder</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">3 x Funktions-Taster</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bildschirm:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 frontseitige Multi-Touch-Farbdisplays</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Audio:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (internes Mic): 70 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (Headset Mic): 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (Headset Hörer): 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (interner Speaker): 120 Hz  16,6 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audio I/O 20 Hz  20 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sample Rate: 48 kHz/ 24 Bit</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Umgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: 0° - 45°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 20 - 90% (nicht kondensierend)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (B, H, T): max. 265 mm × 90 mm × 180 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 2 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Strom:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Spannung: 100  240 VAC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verbrauch: ≤30 W, ≤85 BTU/hr</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Sprechstelle liefern, betriebsfertig aufstellen, anschließen und konfigurieren, inkl. aller notwendigen Kleinteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">IP-Sprechstelle, 12 Tasten, Tischversion</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id106" RNoPart="10"><Qty>5.000</Qty><QU>St</QU><UP>359.550</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom-Applikation passend zu in Vorposition beschriebener Sprechstelle/ Nutzer-Interface.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Intercom-Applikation aktiviert 12 (zwölf) Intercom Tasten, individuelle Lautstärkeneinstellung, AES67/AVB und Ethernet Konnektivität sowie Headset und USB Anschlüsse an Sprechstelle/ Nutzer-Interface.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Software Intercom-Applikation liefern, installieren, konfigurieren und in Betrieb nehmen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Software Intercom-App</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id107" RNoPart="11"><Qty>3.000</Qty><QU>St</QU><UP>3215.980</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aktive und dezentrale Antenne mit PTP2 Taktgeber und E-Ink Display zur Versorgung von bis zu 10 Beltpacks. Die Antennen eines Systems bauen auf eine lizenzfreie zellulare Architektur auf.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Im Standalone Modus können die Antennen wahlweise einzeln in einer Ringstruktur oder kaskadiert oder sternförmig in einem Standard-AES67-IP-Netzwerk betrieben werden. Audiomischung und alle Steuerungsfunktionen werden in diesem Fall von den Antennen übernommen. Im Zusammenspiel mit der passenden Matrixplattform werden die Antennen in einem Standard-AES67-IP-Netzwerk betrieben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bis zu 100 Antennen, 250 Beltpacks und 128 Audiokanäle können in ein System integriert werden. Bis zu 10 Beltpacks können an einer einzelnen Antenne angemeldet sein. Die Übergabe eines Beltpacks zwischen den Antennen geschieht unterbrechungsfrei und ohne Drop-Outs.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Antenne wird über PoE+ und/oder per Netzteil  mit Spannung versorgt. Alternativ können bis zu 5 (fünf) Antennen über ein externes Netzteil betrieben werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Spannung 4-Pin-XLR male</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x AES67 RJ-45</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x Link RJ-45</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB-C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bedienelemente:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">5 x Drucktasten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x NFC Kontaktpunkt</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anzeigen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x E-Ink Display</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">9 x Status LED</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzahl Beltpacks pro Antenne: 10</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RF-Frequenzbereich: 1.880  1.930 GHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RF-Abdeckung Innenbereich: ca. 200 m  400 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RF-Abdeckung Außenbereich: ca. 300 m  500 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Reichweite Antenne Beltpack Innenbereich: max. 200 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Reichweite Antenne Beltpack Außenbereich: max. 250 m</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkanschluss: SMPTE 2110 (AES67)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stromverbrauch: 15 W</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Umgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: -10° C - 45° C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 0 - 90%</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart: IP-53</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (B, H, T): max. 210 mm x 190 mm x 66 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 1,5 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Antenne liefern, betriebsfertig montieren und anschließen inkl. aller notwendigen Kleinteile.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Intercom DECT-Antenne</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id108" RNoPart="12"><Qty>5.000</Qty><QU>St</QU><UP>2637.700</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kabelloses 6 (sechs) kanaliges Intercom Beltpack mit 6 Drucktasten, 2 frei konfigurierbaren Handheld-Tasten, einer Antwort-Taste sowie 2 Lautstärkereglern. Das Beltpack verfügt über 6 (sechs) Voll-Duplex-Pfade mit individueller Lautstärke.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Beltpack verfügt über jeweils ein integriertes Electret Mikrofon und einen Lautsprecher, so dass es auch wie ein Funksprechgerät verwendet werden kann.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Beltpack verfügt ein farbiges dreh- und dimmbares LCD-Display und Vibrationsalarm.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Registrierung im System erfolgt wahlweise über Funk, NFC an der Antenne oder einem bereits registrierten Beltpack. Das Beltpack verfügt über eine Bluetooth Schnittstelle zur Nutzung drahtloser Headsets oder zur Kopplung eines Mobiltelefons.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Angaben:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Line-In: 3.5 mm Klinkenbuchse (40 Hz  20 kHz)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB 2.0</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Headset 4-Pin-XLR male</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Bedienelemente:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4 x Drucktasten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x Handheld-Tasten (Walkie-Talkie)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Antworttaste</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2 x Lautstärkeregler</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Farb-LCD-Display, dreh- und dimmbar</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Menu Taster</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audio-Frequenzgang: 200 Hz - 7 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Interner Lautsprecher: 500 Hz - 7 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebsart: 6 (sechs) Vollduplex Pfade</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verschlüsselung: AES-256</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Akku-Betriebszeit: ca. 17 Stunden</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Umgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: -10° C - 55° C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 0 - 90%</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart: IP65</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (B, H, T): max. 90 mm × 130 mm × 50 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 450 g (inkl. Clip &#x26; Akku)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Beltpack liefern, laden, betriebsfertig konfigurieren, testen und an Nutzer übergeben, inkl. Clip, inkl. Lithium-Ionen-Akku.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kabelloses DECT-Beltback, mit Farbdisplay, 4-Kanal, inkl. Zubehör</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id109" RNoPart="13"><Qty>1.000</Qty><QU>St</QU><UP>1877.650</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ladestation zur Tisch- oder Wandmontage mit integrierter universeller Spannungsversorgung für das simultane Aufladen von bis zu 5 in Vorposition beschriebenen Beltpacks oder Beltpack-Akkus. Die Ladestation ermöglicht auch das Überspielen von Firmware Updates auf die Beltpacks.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Anforderungen:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anzahl Steckplätze: 5</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Beltpack Ladezeit: max. 180 Minuten</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 LED Ladestandanzeige pro Schlitz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB-A</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x USB-C</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x Netzwerk RJ45</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1 x IEC</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Umgebung:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: -10° - 45°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 20- 90%</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schutzart: IP65</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Physikalische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (B, H, T): max. 380 mm x 95 mm x 135 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: max. 1,2 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ladestation liefern, betriebsfertig aufstellen/ montieren und an Nutzer übergeben.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">5x Akku-Ladegerät für Beltpack Batterien</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id110" RNoPart="14"><Qty>1.000</Qty><QU>St</QU><UP>6401.990</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Universelle Funkschnittstelle zum Anschluss von drahtlosen Funksystemen an drahtgebundene Gegensprechanlagen (4-Draht); 19&#x22;/2HE; integriertes Netzteil und Lüfter; programmierbare HF-Sendeleistung; DSP-Funktionen für die Audioverarbeitung; Repeaterfunktion; Dieses Modell kann im Halbduplex- oder 2-Kanal-Simplex-Modus betrieben werden; Diese &#x22;Dual&#x22;-Version ist mit zwei Mobilfunkgeräten der Motorola DM4000-Serie ausgestattet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einbindung der Intercom-Signale in die Steuerungslogik des Systems, Kommunikationszuordnung zwischen Steuerungssystem und Funk-Intercom-Schnittstelle zur integration des vorhandenen Motorola dp1400 Funksystems.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Verknüpfung mit bestehenden Durchruf- und Intercom-Funktionen, sodass Sprechwege und Ruflogiken über das zentrale Steuerungssystem steuerbar werden. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abbildung der Schnittstellenfunktionen innerhalb der Systemoberfläche (z. B. Steuerseiten, Auslöser, Zuweisungen).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Test, Parametrierung und Funktionsabgleich mit der in &#x22;Intercom&#x22; gelisteten Hardware-Schnittstelle.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anbindung Funk Intercom inkl. 2 Mobilfunkgeräte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id111" RNoPart="15"><Qty>0.000</Qty><QU>St</QU><UP>1086.580</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Mikrofonverstärker mit Kompressor und Phantomspeisung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ein hochwertiger, klar klingender Mikrofonverstärker für Kommunikationszwecke ist am Ausgang der Mikrofonkapsel des Handapparats integriert. Zusätzlich verfügt er über eine Kompressor-/Limiter-Schaltung, die dazu beiträgt, Pegel und Sprachverständlichkeit konstant zu halten, selbst wenn der Bediener sehr aufgeregt spricht. Die Verstärkung des Mikrofonverstärkers kann über das Menüsystem an die jeweilige Arbeitsumgebung angepasst werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">H</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">andapparat-Lautsprecherverstärker mit Lautstärkeregelung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ein rauscharm arbeitender Verstärker sorgt für eine bestmögliche Ausgabe am Hörer des Handapparats. Eine Lautstärkeregelung ermöglicht es dem Benutzer, die Lautstärke des Ohrhörers einfach einzustellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Eingangspegel-Verstärkung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zusätzlich zur Lautstärkeregelung für den Ohrhörer des Telefonhandapparats kann über das Menüsystem auch die Verstärkung der eingehenden Netzwerk-Audiosignale angepasst werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Ein einziges Kabel für Stromversorgung und Audio</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ein einziges standardmäßiges RJ45-Netzwerkkabel überträgt sowohl die Stromversorgung (PoE) als auch bidirektionales, mehrkanaliges digitales Audio (Dante®/AES67-kompatibel).</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">NETZWERK- / DANTE®-SCHNITTSTELLE</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Physikalische Schnittstelle: 1 × RJ45 Neutrik Ethercon</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audio-Abtastrate: 48 kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audio-Auflösung: 24 Bit</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übertragungsrate: 100 Mbit/s</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dante®-Chipsatz: Ultimo UXT-01-004</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hinweis: Audinate empfiehlt, nicht mehr als 10 Ultimo-Chipsätze in einem Netzwerk zu betreiben, es sei denn, ein weiteres Dante®-Gerät wie z. B. das Brooklyn-Modul (verbaut in 8-Kanal-Beatrice-/Dark-Geräten) befindet sich im selben Netzwerk.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">AES67-kompatibel: Der Audinate-Ultimo-Chipsatz ist AES67-konform.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">STROMVERSORGUNG</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistungsaufnahme: PoE</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Versorgung: Gespeist über Power over Ethernet (PoE)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Normkonformität: IEEE 802.3af-2003, Klassifizierung Klasse 0</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">MECHANISCHE EIGENSCHAFTEN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gehäuse: Vollaluminium, lasergravierte Frontplatten, Seiten schwarz pulverbeschichtet mit leichter Struktur</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Telefonhörer: Interquartz 9826N</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen (Gehäuse ohne Gürtelclip): 120 × 280 × 95 mm (B × L × H)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">(inkl. Hörer: 45 mm, ohne Hörer)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht: 835 g</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Versandgewicht: 2 kg</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Versandabmessungen: 62 × 41 × 17 cm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Versandkarton: Robuster Exportkarton in Industriequalität</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">UMGEBUNGSBEDINGUNGEN</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betriebstemperatur: 0 bis +50 °C (32 bis 122 °F)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lagertemperatur: -20 bis +70 °C (-4 bis 158 °F)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Relative Luftfeuchtigkeit: 0 bis 95 %, nicht kondensierend</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">IP-Sprechstelle, 1 Taste, Telefonhörer</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>65008.65</Total><TotalGross>77360.29</TotalGross></Totals></BoQCtgy><BoQCtgy ID="id112" RNoPart="04"><LblTx><p><span>Mitschauanlage</span></p></LblTx><BoQBody><Itemlist><Remark ID="id113"><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das bestehende Mitschausystem wird großteils überholt.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das Mitschausystem dient der latenzarmen, zentral steuerbaren Bildüberwachung des Bühnen- und Zuschauerraums und stellt allen relevanten Betriebsstellen ein anwählbares Mitschausignal aus einzel oder Multiview Bild zur Verfügung.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zweck und Funktion</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Das neue System erfasst die Bühnen- und Saalsituation über eine PTZ-Kamera, eine Nachtsichtkamera sowie eine mobile Kamera für die Bühnenaufsicht und stellt die Signale für Inspizient, Bühnen- und Haustechnik sowie ausgewählte Nebenräume bereit.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Videoverteilung erfolgt über eine SDI-Routingmatrix mit Multiviewer und MPEG-4-Streaming-Encoder, sodass neben den SDI-Mitschaumonitoren auch netzwerkfähige Monitore  mit dem Mitschausignal versorgt werden. Alle Signale sollen in FHD übertragen werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistungsumfang</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Zum Leistungsumfang gehören Lieferung, Montage und Inbetriebnahme der Kameras, des SDI-Routers, des 4-fach-Multiviewers, des Streaming-Encoders sowie der zugehörigen Bildschirme einschließlich aller erforderlichen Leitungen, Patchfelder und Anschlussarbeiten.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ebenfalls enthalten sind die Integration der Kamerasteuerung in das Inspizientenpult, die Anbindung an das vorhandene SDI- bzw. EDV-Netz sowie die Parametrierung und Einweisung des Nutzerpersonals in Bedienung und Umschaltfunktionen der Mitschauanlage.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vortext</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="id114" RNoPart="1"><Qty>1.000</Qty><QU>St</QU><UP>2012.500</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lieferung einer motorisierten PTZ-Kamera für professionelle Videoerfassung, Live-Übertragung und Streaming. Die Kamera muss folgende Funktionen und Eigenschaften aufweisen: </span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildauflösung: Aufnahme und Ausgabe in UHD/4K sowie Full-HD, mit hoher Bildqualität und stabiler Farbwiedergabe.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Optik: Mindestens 12-fach optischer Zoom, große Abdeckung von Weitwinkel bis Tele; zusätzlich digitaler Zoom möglich.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">PTZ-Funktion: Motorisierte Schwenk-/Neigeeinheit mit präziser Bewegung, mehreren speicherbaren Preset-Positionen und ruckfreiem Anfahren.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Videoausgänge: Mehrere parallele Ausgabemöglichkeiten wie SDI (mind. 3G-SDI), HDMI, USB und Netzwerk-Streaming zur gleichzeitigen Verwendung in verschiedenen Systemen.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerk &#x26; Streaming: Unterstützung gängiger IP-Protokolle für Videoübertragung und Fernsteuerung; geeignet für professionelle Streaming-Workflows.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Steuerung: Fernbedienbare PTZ-Funktionen über Netzwerk, serielle Steuerung oder kompatible Steuerpulte; Integration in Medientechnik-Systeme möglich.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Einsatzbereich: Geeignet für Studio-, Konferenz-, Präsentations-, Gottesdienst- und Veranstaltungsumgebungen; flexible Montageoptionen für Wand, Decke oder Stativ.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betrieb: Leiser, präziser Motorbetrieb; stabile Performance auch im Dauerbetrieb.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kamera PTZ 4K geringe Latenz</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id115" RNoPart="2"><Qty>1.000</Qty><QU>St</QU><UP>572.700</UP><TimeQu>1.00</TimeQu><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lieferung einer kompakten tages- und nachtgeeigneten Kamera mit hoher Lichtempfindlichkeit. Anforderungen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildsensor: Hochauflösender 1/2,8&#x22;-CMOS-Sensor mit hoher Empfindlichkeit für den Einsatz bei sehr schwachen Lichtverhältnissen (Mindestszene-Beleuchtung ca. 0,003 lx oder besser).</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auflösung mind. 1920x1080, 1080p@60/50fps, Optisch 10x Auto Fokus Zoom, 5,1~51mm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Automatische Tag/Nacht-Betrieb über einen schaltbaren IR-Sperrfilter (ICR). Digitale Rauschunterdrückung (2D/3D-DNR) und Wide Dynamic Range (WDR =120 dB) für hohe Bildqualität bei schwierigen </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lichtverhältnissen sowie interne Signalverarbeitung mit automatischer Belichtung, Gegenlichtkorrektur, Bildstabilisierung und Defog-Funktion.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Videosignal-Ausgänge, HD-SDI zur Anbindung an die Mitschau-Singnalverarbeitung, Steuerungs-Eingänge über RS-485</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kompakte Metallbauform zur Inneninstallation, geeignet für Wand- oder Deckenmontage.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kamera fix Full-HD Nachtsicht</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id116" RNoPart="3"><Qty>1.000</Qty><QU>St</QU><UP>1045.350</UP><TimeQu>1.00</TimeQu><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lieferung einer kompakten Ultra-HD-Box-Kamera für hochwertige Videoerfassung, Live-Übertragung und Streaming. Anforderungen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">hochauflösender 1/2,8&#x22;-CMOS-Sensor (8,4 MP)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4K-Videoausgabe bis 60 fps über HDMI sowie Full-HD über SDI, USB-Video und IP-Streaming. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">optisches 12-fach-Zoomobjektiv (4,1-49,2 mm, F1.8-F2.68) </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">horizontales Sichtfeld von ca. 72,5° bis 6,9°. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">umfangreiche interne Bildverarbeitung, automatische Belichtungssteuerung, Gegenlichtkorrektur, Bildflip/-mirror und unterstützt bis zu 255 Kamerapresets. </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Lichtempfindlichkeit liegt bei mind. 0,5 lx</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mehrfachausgänge für parallele Signalbereitstellung, 3G-SDI, HDMI 2.0, USB-Video (UVC), IP-Streaming (RTSP/RTMP/SRT/NDI HX3).</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schnittstellen für Ethernet (10/100/1000), USB-C 3.0, RS-485.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kompakte Bauform max. 150 × 80 × 80 mm zur Inneninstallation, geeignet für Wand- oder Deckenmontage.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Geeignet für stabilen Dauerbetrieb im Temperaturbereich -10 °C bis +40 °C.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Halterung.</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Kamera fix 4K mobil</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id117" RNoPart="4"><Qty>3.000</Qty><QU>St</QU><UP>936.100</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildschirmdiagonale: 32&#x22;</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auflösung: mind. 1920 x 1080 (FHD)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildwiederholfrequenz: min. 60 Hz bei Anschluss über HDMI</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Antwortzeit (Bildschirm Grau-zu-Grau): max. 5 ms</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Videoanschlüsse: HDMI Input &#x26; DisplayPort Input</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mechanische Halterung: VESA 100 x 100 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. geeignete Wandhalterung Halterung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Streaming Decoder zur zuverlässigen Wiedergabe und Übertragung von Video-Streams in professionellen Medien- und Broadcast-Umgebungen. Anforderungen:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Videoformate: Wiedergabe und Streaming von Full HD (1080p) bei hohen Bildraten; Unterstützung moderner Kompressionsverfahren.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Codecs: Unterstützung gängiger Video- und Audio-Codecs, darunter H.264/AVC, H.265/HEVC, MPEG-1/2, VP9, sowie gängige Audioformate wie AAC, MP3, WAV/PCM.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Streaming-Funktionen: RTMP/RTMPS-Streaming für Plattformen wie Web-/Cloud-Dienste, RTSP-Bereitstellung im lokalen Netzwerk, UDP/RTP-Unterstützung sowie Steuerung über IP.</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Trigger-/Event-gesteuerte Wiedergabe.</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anschlüsse:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Digitale Videoausgabe (z. B. HDMI) für lokale Displays</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Netzwerkanschluss (Ethernet) für Streaming, Steuerung und Inhalte</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">USB-Schnittstellen zur Medienwiedergabe oder Peripherieeinbindung</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Betrieb &#x26; Steuerung: Webbasierte oder netzwerkgestützte Konfiguration; zuverlässiger 24/7-Dauerbetrieb; </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildschirm 32&#x22; FHD HDMI inkl. Streaming Decoder + Halterung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id118" RNoPart="5"><Qty>1.000</Qty><QU>St</QU><UP>414.000</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">TFT LCD Bildschirm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bildschirmdiagonale von 31.5&#x22;</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auflösung: FHD 1920x1080</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:1