BauID><STLBBauID><ArtChrIdent>11910</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>8</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10617</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>29</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2163</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>6</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>9122</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>10</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2136</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Elektroinstallationsrohr DIN EN 61386 (VDE 0605), Maße DIN EN 60423, nicht flammenausbreitend, aus beschichtetem Stahl, einwandig, glatt, starr, Außendurchmesser 25 mm, Druckfestigkeit Klasse 4 - schwer (1250 N) DIN EN 61386-1 (VDE 0605-1), Klasse Schlagbeanspruchung 4 - schwer DIN EN 61386-1 (VDE 0605-1), Verlegung offen, auf Putz, mit Abstandsschellen.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Elektroinstallationsrohr Stahl besch AD 25mm AP Abstandsschellen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id157" RNoPart="40"><Qty>10.000</Qty><QU>m</QU><UP>20.580</UP><TimeQu>0.17</TimeQu><Description><STLBBau><STLBBauCtlg><CtlgName>STLB-Bau</CtlgName><VersDate>2021-04</VersDate><WCtg>053</WCtg><Group>3275</Group></STLBBauCtlg><STLBBauID><ArtChrIdent>10435</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>205</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11905</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>10</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11267</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>9731</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>18</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>23127</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>4</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11271</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>4</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11272</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>6</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>11910</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>8</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10617</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>29</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2163</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>6</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>9122</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>10</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>10164</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>1</ChVIdent></STLBBauID><STLBBauID><ArtChrIdent>2136</ArtChrIdent><ArtChIdx>0</ArtChIdx><ChVIdent>2</ChVIdent></STLBBauID></STLBBau><CompleteText><DetailTxt><Text><span style="font-family:Arial;font-size:10pt;">Elektroinstallationsrohr DIN EN 61386 (VDE 0605), Maße DIN EN 60423, nicht flammenausbreitend, aus beschichtetem Stahl, einwandig, glatt, starr, Außendurchmesser 40 mm, Druckfestigkeit Klasse 4 - schwer (1250 N) DIN EN 61386-1 (VDE 0605-1), Klasse Schlagbeanspruchung 4 - schwer DIN EN 61386-1 (VDE 0605-1), Verlegung offen, auf Putz, mit Abstandsschellen.</span></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Elektroinstallationsrohr Stahl besch AD 40mm AP Abstandsschellen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody><Totals><Total>629.00</Total></Totals></BoQCtgy></BoQBody><Totals><Total>1169.00</Total><TotalGross>1391.11</TotalGross></Totals></BoQCtgy><BoQCtgy ID="id158" RNoPart="10"><LblTx><p><span>Mithör- und Rufanlage</span></p></LblTx><BoQBody><Itemlist><PerfDescr ID="id159"><PerfNo>5</PerfNo><PerfLbl>Vortext Mithör- und Rufanlage</PerfLbl><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Für die Bühne müssen Mithörsignale generiert werden.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Hierfür werden neue Richtmikrofone im Saal Installiert und diese durch die Audio DSP im Zentralen Rack Schrank Verstärkt und in das Dante Netz eingespeist. Die Leitungsführung der Mikrofone führt über eine Neu zu errichtende Verbindung am Rang der beiden Positionen zum FOH Ton im Saal. Dort kann ein vorhandener Leitungsweg über ein XLR-Multicore Genutzt werden, welche direkt am Zentralen Inspizienten Rack endet.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Somit bestehen dann automatisch eine Verbindung zur Intercom Matrix. Die Schwerhörigenanlage wird mit einem Line-Signal angesteuert, welches direkt am Rack bereit gestellt werden muss.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Alle Einstellungen im Mischpult-DSP sind als Preset speicher- und wiederaufrufbar und unabhängig der Szenenautomation.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Dieses gilt auch am Inspizientenpult, bei dem über die Steuerung ebenso diese Einstellungen im Zugriff sind.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Zuschaltung der Mithöranlage obliegt neben der Tontechnik einzig dem Inspizienten!</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eine optische Signalisierung, dass die Anlage aktiv geschaltet ist, wird nur im Inspizientenpult aber nicht im Haus benötigt. Folgende Zustände können durch den Inspizienten erzeugt werden:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Anlage Aus Deaktiviert</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vorstellung Aktiviert Gesamtes Haus ist freigeschaltet</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;font-weight:bold;"><span style="font-family:Arial;font-size:10pt;">Rufanlage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Anlage besteht aus neu errichteten 100-V-Wandaufbaulautsprechern mit lokalem Lautstärkeregler und Programmwahlschalter, zusätzlichen IP-Lautsprechern (Dante, PoE) in Bereichen ohne 100-V-Abdeckung sowie zentralen 100-V-Verstärkern mit Havarie-Umschaltung in der Unterbühnenzentrale.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die bestehenden 8 Rufkreise werden mit der neuen Technik wiederhergestellt, sodass jeder Versorgungsbereich gezielt adressiert werden kann und gleichzeitig eine Pflichtbeschallung über Pflichtrelais  sichergestellt wird.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Rufanlage muss durch die Benutzer frei konfiguriert werden können. Die Lautstärken der Rufe und des Mithörsignals sollen individuell einstellbar und über das InspiPult in der Lautstärke voreinstellbar und abspeicherbar sein.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Auslösung der Rufkreise erfolgt jeweils über die in die I-Pulte eingebauten Sprechstellen.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Lautsprecher übernehmen weiterhin auch die Funktion des Mithörens.</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aus einem Sprachspeicher soll auf der Rufanlage ein Pausengong und eine Räumungsansage abgespielt werden können.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Vortext Mithör- und Rufanlage</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></PerfDescr><Item ID="id160" RNoPart="1"><RefPerfNo IDRef="id159"/><Qty>2.000</Qty><QU>St</QU><UP>235.750</UP><TimeQu>1.00</TimeQu><Description><CompleteText><DetailTxt><Text><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen Durchmesser 20 mm, Länge 256 mm </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wandlerprinzip Hochfrequenz-Kondensatormikrofon</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audio-Übertragungsbereich 40 - 20000 Hz</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht 128 g </span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Audioausgang XLR-3M, symmetrisch erdfrei, ohne übertrager</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Richtcharakteristik Superniere / Keule</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Empfindlichkeit: 21 mv/Pa mit P48, 19mV/Pa mit Batterie Speisung</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Phantomspeisung 48 V +/- 4 V</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Ersatzgeräuschpegel 15 dB (A)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maximaler Schalldruckpegel: 132 dB SPL</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stromaufnahme max. 3,3 mA</span></p></li></ul></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Mithörmikrofon Richtrohr</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id161" RNoPart="2"><Qty>1.000</Qty><QU>St</QU><UP>255.250</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">DANTE Interface</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">kompaktes Dante Interface für Installationen</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Auflösung: 96kHz / 48kHz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Eingänge: 2 XLR-Kombo Buchse Mic/Line Inputs (mit 48V Phantomspeisung)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">AES67 kompatibel</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">bereit für Dante Domain Manager</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stromversorgung über PoE oder beiliegendes 12Volt Netzteil</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">optionales 19&#x22; Rackkit (580604)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">optionale Montagewinkel (580606)</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Abmessungen BxTxH 130 x 102 x 42 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht 1,0 kg</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wandler IP-Audio 2-Kanal Mikrofon</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id162" RNoPart="3"><Qty>51.000</Qty><QU>St</QU><UP>90.850</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gehäuselautsprecher einschl. Frontabdeckung mit Lautstärkeregler, Programmwahlschalter und 24V Pflichtrufrelais, für Wandmontage, direkt, für Innenbereich,</span><br/><span>Nennbelastbarkeit ‘6‘ W, Schalldruck in 1 m Entfernung bei 1 W Belastung mind. 90 dB, mit Übertrager für 100 V Leistungsanpassung 1:1, 1:2 und 1:4, Gehäuse aus Holz, Abdeckung Lochblech, Montagehöhe bis 3 m.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="margin-top:0pt;margin-bottom:0pt;width:405pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Wandaufbaulautsprecher mit Lautstärkeregler, Programmwahlschalter und 24V Pflichtrufrelais 100V, 6W</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id163" RNoPart="4"><Qty>2.000</Qty><QU>St</QU><UP>64.140</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Monitorbox mit 2-Wege-System, mit Tiefton- und Mittelhochtonchassis und Thermosicherung. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gehäuse aus High-Density-ABS-Kunststoff, wetterfest. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Durch Schutzklasse IP 33C gegen die Risiken von Umwelteinflüssen gesichert. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Die Montage erfolgt über ein Dreh-Kugelgelenk. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Der Anschluss erfolgt über eine stabile 6-polige Schraubklemme mit Berührungsschutz. </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">RoHS-Konform</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Technische Daten:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Nennleistung/Nennrauschleistung: 100 V (W): 50/25/12,5/6,25</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Niederohmige Anpassung (Ohm): 8 </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maße (mm): Ø 326x202x192</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht (kg): 3,65</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Farbe: schwarz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Übertragungsbereich (-10dB) IEC268-5 (Hz): 63 - 20.100</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang (Hz): 53 - 20.300</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schalldruckpegel IEC268-5, 1W/1m (dB): 88,2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schalldruckpegel IEC268-5, 1W/4m (dB): 76,2</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Schalldruckpegel IEC268-5, Pmax./4m (dB): 93,1</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Öffnungswinkel -6 dB, 500 Hz: h=194° v=185°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Öffnungswinkel -6 dB, 1 kHz: h=152° v=114°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Öffnungswinkel -6 dB, 2 kHz: h=97° v=103°</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Öffnungswinkel -6 dB, 4 kHz: h=64° v=43°</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2-Wege Monitorbox, 50 Watt, 100V</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id164" RNoPart="5"><Qty>16.000</Qty><QU>St</QU><UP>569.250</UP><Description><CompleteText><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aktiver Monitor mit folgenden Eigenschaften:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Leistung: 20 Watt</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Farbe: Weiß </span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Bestückung: 10 cm Full Range Lautsprecher</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzbereich: 80 - 14.000 Hz</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">mit Dante Schnittstelle, Lautstärkeregler, Aufwahlmöglichkeit des Dante-Kanals inkl. Prioritätsschaltung</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">magnetisch geschirmtes Gehäuse</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Maße maximal (B x H x T): 125 x 190 x 125 mm</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Gewicht:ca. 2,0 kg</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Aktivlautsprecher IP 20W PoE</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id165" RNoPart="6"><Qty>5.000</Qty><QU>St</QU><UP>1400.000</UP><Description><CompleteText><ComplTSA>Yes</ComplTSA><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">100V 2-Kanal Verstärker</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">9,5&#x22; Gerät; 1HE</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">min. Ausgangsleistung pro Kanal:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">60W @ 8 Ohm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">125W @ 100V</span></p></li></ul></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">minimale Anschlüsse:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">2x Analoge Schraubklemme Ausgänge</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1x Stromversorgung IEC C20 Einlass</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">1x Netzwerk Anschluss</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">4x GPIO Schraubklemme</span></p></li></ul></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Frequenzgang von 20 Hz bis 20 kHz</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Störabstand: &#x3e;100 dB(A)</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">Stromversorgung: 100-240VAC bei 50-60Hz</span></p></li></ul><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">inkl. Zubehör für Rackmontage</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-weight:bold;font-family:Arial;">Angebote </span><span style="font-size:10pt;font-family:Arial;">(vom Bieter einzutragen)</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;">:</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="11" Kind="Owner"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Fabrikat: </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;QSYS&#x27;</span></ComplBody><ComplTail><br/></ComplTail></TextComplement><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/></Text><TextComplement MarkLbl="12" Kind="Owner"><ComplCaption><span style="font-family:Arial;font-size:10pt;">Typ: </span></ComplCaption><ComplBody><span style="font-family:Arial;font-size:10pt;">&#x27;SPA-QF 60x2&#x27;</span></ComplBody><ComplTail/></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p style="width:481pt;margin-top:0pt;margin-bottom:0pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">100V 2-Kanal Verstärker, je 125W, netzwerkfähig</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="id166" RNoPart="7"><Qty>1.000</Qty><QU>St</QU><UP>1650.000</UP><Description><CompleteText><ComplTSA>Yes</ComplTSA><DetailTxt><Text><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">100V 2-Kanal Verstärker</span></p><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"/><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">9,5&#x22; Gerät; 1HE</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">min. Ausgangsleistung pro Kanal:</span></p><ul><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;"><span style="font-size:10pt;font-family:Arial;">200W</span><span style="font-size:10pt;font-weight:bold;font-family:Arial;"> </span><span style="font-size:10pt;font-family:Arial;">@ 8 Ohm</span></p></li><li><p style="margin-top:0pt;margin-bottom:0pt;width:284pt;font-size:10pt;"><span style="font-family:Arial;font-size:10pt;">400W @ 100V</span></p></li></ul></li><li><p style="